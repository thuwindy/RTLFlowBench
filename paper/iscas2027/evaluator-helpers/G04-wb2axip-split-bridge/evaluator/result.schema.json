{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/g04-development-evaluator-result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "suite_status", "verdict", "pass", "oracle_completion", "checks", "metrics", "evidence_manifest", "excluded_claims"],
  "properties": {
    "schema_version": {"const": "rtlflowbench.g04_development_result.v1"},
    "task_id": {"const": "G04-wb2axip-split-bridge"},
    "suite_status": {"const": "development_not_frozen"},
    "verdict": {"enum": ["invalid_submission", "scope_violation", "infra_error", "timeout", "compile_error", "fail_f2p", "fail_p2p", "fail_formal", "pass"]},
    "pass": {"type": "boolean"},
    "oracle_completion": {
      "type": "object", "additionalProperties": false,
      "required": ["visible", "hidden_f2p", "hidden_p2p", "formal", "synthesis", "complete"],
      "properties": {
        "visible": {"type": "boolean"}, "hidden_f2p": {"type": "boolean"},
        "hidden_p2p": {"type": "boolean"}, "formal": {"type": "boolean"},
        "synthesis": {"type": "boolean"}, "complete": {"type": "boolean"}
      }
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["functional_correctness", "protocol_correctness", "f2p", "p2p", "formal_depth", "simulation_coverage", "mutation_kill_rate", "false_positive_rate", "wall_time_seconds"],
      "properties": {
        "functional_correctness": {"type": ["boolean", "null"]},
        "protocol_correctness": {"type": ["boolean", "null"]},
        "f2p": {"type": ["boolean", "null"]},
        "p2p": {"type": ["boolean", "null"]},
        "formal_depth": {"type": ["integer", "null"], "minimum": 0},
        "simulation_coverage": {"type": ["number", "null"], "minimum": 0},
        "mutation_kill_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_positive_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "wall_time_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidence_manifest": {"type": "array", "items": {"type": "object"}},
    "excluded_claims": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "error": {"type": "string"}
  }
}
