    {"name": "i_wb_err", "direction": "input", "width": "1"}
  ],
  "transaction_semantics": {
    "axi_handshake": "A channel transfer occurs only on VALID && READY at a rising edge",
    "aw_w_independence": "AW and W may be accepted in either order and are paired in acceptance order by the supplied write dependency",
    "wishbone_request_accept": "o_wb_cyc && o_wb_stb && !i_wb_stall at a rising edge",
    "wishbone_completion": "Exactly one of i_wb_ack or i_wb_err completes an accepted beat",
    "ordering": "Read and write responses preserve per-channel AXI acceptance order",
    "owner_hold": "A granted internal master owns the external bus until that internal CYC deasserts",
    "response_isolation": "ACK, ERR, and read data are visible only to the selected owner"
  },
  "arbitration_semantics": {
    "unit": "complete_internal_wishbone_cycle",
    "single_request": "grant the sole requester",
    "simultaneous_after_reset": "grant read",
    "simultaneous_after_completion": "grant the master other than the most recently completed owner",
    "non_owner": "forced stalled and receives no ACK or ERR"
  },
  "state_semantics": {
    "stalled_output": "While o_wb_cyc && o_wb_stb && i_wb_stall, WE, address, data, and select remain stable",
    "normal_response": "AXI response is OKAY (2'b00)",
    "error_response": "AXI response is SLVERR (2'b10)",
    "reset_state": "No owner, no Wishbone request, read wins the next simultaneous request, and no pre-reset response survives"
  },
  "latency_semantics": {
    "mode": "functional_not_cycle_frozen",
    "combinational_fall_through_required": false,
    "progress": "Every accepted request eventually receives one response when the external target eventually accepts and completes every request"
  },
  "invalid_parameter_behavior": {"required_result": "elaboration_or_static_failure", "runtime_behavior_defined": false},
