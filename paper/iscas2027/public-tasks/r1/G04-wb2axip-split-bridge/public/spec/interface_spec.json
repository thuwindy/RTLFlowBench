    {"name": "C_AXI_ADDR_WIDTH", "type": "positive_integer", "default": 28, "valid_range": "C_AXI_ADDR_WIDTH > $clog2(C_AXI_DATA_WIDTH/8)"},
    {"name": "LGFIFO", "type": "positive_integer", "default": 3, "valid_range": "LGFIFO >= 1"}
  ],
  "derived_widths": {
