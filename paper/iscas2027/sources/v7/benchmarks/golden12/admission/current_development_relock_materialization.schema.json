{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/current-development-relock-materialization.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "status",
    "classification",
    "candidate_receipt_sha256",
    "authority",
    "task_count",
    "benchmark_ready_task_count",
    "chipflow_adapter_ready_task_count",
    "pretransition_signature_reuse_permitted",
    "review_bundle_rebuild_required",
    "census_permitted",
    "workflow_workspace_exposure_permitted",
    "source",
    "tasks",
    "excluded_claims"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "taskId": {
      "enum": [
        "G01-common-fifo-spec",
        "G02-common-rr-arbiter-spec",
        "G03-axis-fifo-backpressure",
        "G04-wb2axip-split-bridge",
        "G05-picorv32-missing-irq",
        "G06-ibex-debug-csr-exception",
        "G07-ibex-ifetch-error-timing",
        "G08-common-fifo-dv",
        "G09-axis-fifo-dv",
        "G10-serv-area-qor",
        "G11-picorv32-qor",
        "G12-common-cdc-missing-contract"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.current_development_relock_materialization.v1"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {
      "const": "development_locks_applied_pending_review_bundle_rebuild"
    },
    "classification": {"const": "release_authority_only"},
    "candidate_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root", "branch", "head", "status_item_count", "status_sha256"
      ],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/gitCommit"},
        "status_item_count": {"type": "integer", "minimum": 0},
        "status_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task_count": {"const": 12},
    "benchmark_ready_task_count": {"const": 0},
    "chipflow_adapter_ready_task_count": {"const": 0},
    "pretransition_signature_reuse_permitted": {"const": false},
    "review_bundle_rebuild_required": {"const": true},
    "census_permitted": {"const": false},
    "workflow_workspace_exposure_permitted": {"const": false},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materializer_sha256", "schema_sha256"],
      "properties": {
        "materializer_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "pretransition_candidate_lock_sha256",
          "pretransition_review_packet_sha256",
          "candidate_lock_sha256",
          "review_packet_sha256",
          "candidate_lock_archive",
          "review_packet_archive",
          "all_review_items_pending",
          "benchmark_ready",
          "chipflow_adapter_ready"
        ],
        "properties": {
          "task_id": {"$ref": "#/$defs/taskId"},
          "pretransition_candidate_lock_sha256": {"$ref": "#/$defs/sha256"},
          "pretransition_review_packet_sha256": {"$ref": "#/$defs/sha256"},
          "candidate_lock_sha256": {"$ref": "#/$defs/sha256"},
          "review_packet_sha256": {"$ref": "#/$defs/sha256"},
          "candidate_lock_archive": {"type": "string", "minLength": 1},
          "review_packet_archive": {"type": "string", "minLength": 1},
          "all_review_items_pending": {"const": true},
          "benchmark_ready": {"const": false},
          "chipflow_adapter_ready": {"const": false}
        }
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
