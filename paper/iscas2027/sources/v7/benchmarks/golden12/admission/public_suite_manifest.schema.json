{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/golden12-public-suite-manifest.v1.json",
  "title": "Golden-12 public suite development manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "observed_at",
    "status",
    "archive_root",
    "entry_count",
    "private_file_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.golden12_public_suite_manifest.v1"
    },
    "suite_id": {
      "const": "Golden-12-v1-development-candidate"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "development_candidate_not_frozen"
    },
    "archive_root": {
      "const": "rtlflowbench-golden12-development-candidate"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "private_file_count": {
      "const": 0
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "role"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^rtlflowbench-golden12-development-candidate/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "public_suite_readme",
            "public_schema",
            "candidate_bound_task_public_archive",
            "task_public_archive_receipt",
            "suite_descriptor"
          ]
        }
      }
    }
  }
}
