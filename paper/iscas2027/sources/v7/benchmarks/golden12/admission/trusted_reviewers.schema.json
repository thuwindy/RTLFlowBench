{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/private/task-trusted-reviewers.v1.json",
  "title": "Golden-12 task trusted reviewer registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature_namespace",
    "registry_authority",
    "governance_status",
    "prohibited_identities",
    "reviewers"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.task_trusted_reviewers.v1"},
    "signature_namespace": {
      "type": "string",
      "pattern": "^rtlflowbench-g(?:0[2-7]|10|11)-review$"
    },
    "registry_authority": {"type": "string", "minLength": 1},
    "governance_status": {
      "enum": ["calibration_only", "pending_independent_approval", "independently_approved"]
    },
    "prohibited_identities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "organization", "key_fingerprint", "allowed_review_ids"],
        "properties": {
          "identity": {"type": "string", "minLength": 1},
          "organization": {"type": ["string", "null"]},
          "key_fingerprint": {
            "type": "string",
            "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
          },
          "allowed_review_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      }
    }
  }
}
