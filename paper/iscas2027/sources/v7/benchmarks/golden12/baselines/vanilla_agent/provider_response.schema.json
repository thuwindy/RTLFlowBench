{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/private/vanilla-provider-response.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "model_config_sha256",
    "usage",
    "claims",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.vanilla_provider_response.v2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "model_config_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "content": {"type": "string", "maxLength": 1048576}
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "old_text", "new_text", "expected_replacements"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "old_text": {"type": "string", "minLength": 1, "maxLength": 131072},
          "new_text": {"type": "string", "maxLength": 131072},
          "expected_replacements": {"const": 1}
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "oneOf": [
    {
      "required": ["files"],
      "not": {"required": ["edits"]}
    },
    {
      "required": ["edits"],
      "not": {"required": ["files"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
