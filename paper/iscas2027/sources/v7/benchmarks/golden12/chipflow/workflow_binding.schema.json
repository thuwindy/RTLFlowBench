{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/private/chipflow-workflow-binding.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "workflow", "runtime_policy",
    "controller_sha256", "workflow_binding_schema_sha256",
    "task_schema_sha256", "workspace_receipt_schema_sha256",
    "decoding_config_sha256", "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.chipflow_workflow_binding.v1"},
    "status": {"enum": ["development_not_frozen", "frozen"]},
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "adapter_name", "adapter_version", "model", "config_sha256"],
      "properties": {
        "name": {"const": "chipflow-native"},
        "version": {"type": "string", "minLength": 1},
        "adapter_name": {"const": "rtlflowbench-chipflow-public-bridge"},
        "adapter_version": {"type": "string", "minLength": 1},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]}
          }
        },
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["controller", "subagents", "approval", "private_evaluator_reachable"],
      "properties": {
        "controller": {"const": "deerflow_official_chipflow_native_stategraph"},
        "subagents": {"enum": ["disabled_fail_closed", "enabled_frozen_runtime"]},
        "approval": {"enum": ["fail_closed_zero_intervention", "scope_hash_bound_controller_preapproval"]},
        "private_evaluator_reachable": {"const": false},
        "public_python_runtime_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "controller_sha256": {"$ref": "#/$defs/sha256"},
    "workflow_binding_schema_sha256": {"$ref": "#/$defs/sha256"},
    "task_schema_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "decoding_config_sha256": {"$ref": "#/$defs/sha256"},
    "excluded_claims": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
