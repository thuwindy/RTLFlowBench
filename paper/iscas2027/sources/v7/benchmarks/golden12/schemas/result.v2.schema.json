{
  "$defs": {
    "failureVerdict": {
      "enum": [
        "invalid_instance",
        "infra_error",
        "invalid_submission",
        "scope_violation",
        "blocked",
        "timeout",
        "compile_error",
        "fail_f2p",
        "fail_p2p",
        "fail_formal",
        "fail_ppa"
      ]
    },
    "metricId": {
      "enum": [
        "functional_correctness",
        "protocol_correctness",
        "f2p",
        "p2p",
        "formal_depth",
        "simulation_coverage",
        "mutation_kill_rate",
        "false_positive_rate",
        "area",
        "timing",
        "performance",
        "scope_violation_count",
        "trust_event_count",
        "wall_time_seconds",
        "input_tokens",
        "output_tokens",
        "llm_calls",
        "eda_calls",
        "human_interventions"
      ]
    },
    "metricObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "missing_reason": {
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "missing_reason": {
                "type": "null"
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "type": "array"
        },
        "metric_id": {
          "$ref": "#/$defs/metricId"
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "measured",
            "not_available",
            "not_applicable"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string",
            "null"
          ]
        }
      },
      "required": [
        "metric_id",
        "status",
        "value",
        "unit",
        "evidence_refs",
        "missing_reason"
      ],
      "type": "object"
    },
    "oracleClass": {
      "enum": [
        "build",
        "lint",
        "simulation",
        "formal",
        "differential",
        "coverage",
        "synthesis",
        "ppa",
        "scope",
        "trust"
      ]
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://rtlflowbench.org/schema/result.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "score": {
            "properties": {
              "dimensions": {
                "maxProperties": 0
              },
              "total": {
                "type": "null"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "score": {
            "properties": {
              "status": {
                "const": "scored"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "properties": {
              "total": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "document_bindings": {
      "additionalProperties": false,
      "properties": {
        "submission_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "task_descriptor_sha256",
        "submission_sha256"
      ],
      "type": "object"
    },
    "evidence_manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "execution_bindings": {
      "additionalProperties": false,
      "properties": {
        "evaluator_runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "evaluator_runner_sha256",
        "source_lock_sha256",
        "runtime_manifest_sha256"
      ],
      "type": "object"
    },
    "oracle_results": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "not_run"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "failure_verdict": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "timeout"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "failure_verdict": {
                  "const": "timeout"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "infra_error"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "failure_verdict": {
                  "const": "infra_error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "failure_verdict": {
                  "enum": [
                    "invalid_instance",
                    "invalid_submission",
                    "scope_violation",
                    "blocked",
                    "compile_error",
                    "fail_f2p",
                    "fail_p2p",
                    "fail_formal",
                    "fail_ppa"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "evidence_refs": {
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "type": "array"
          },
          "failure_verdict": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/failureVerdict"
              }
            ]
          },
          "oracle_class": {
            "$ref": "#/$defs/oracleClass"
          },
          "oracle_id": {
            "minLength": 1,
            "type": "string"
          },
          "pass_sentinel_observed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "timeout",
              "infra_error",
              "not_run"
            ]
          }
        },
        "required": [
          "oracle_id",
          "oracle_class",
          "status",
          "failure_verdict",
          "reason",
          "pass_sentinel_observed",
          "evidence_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "raw_metrics": {
      "items": {
        "$ref": "#/$defs/metricObservation"
      },
      "minItems": 1,
      "type": "array"
    },
    "resource_usage": {
      "additionalProperties": false,
      "properties": {
        "eda_calls": {
          "additionalProperties": false,
          "properties": {
            "compile_or_lint": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "formal": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "simulation": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "synthesis": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "compile_or_lint",
            "simulation",
            "formal",
            "synthesis"
          ],
          "type": "object"
        },
        "human_interventions": {
          "minimum": 0,
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "llm_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "missing_measurements": {
          "items": {
            "enum": [
              "input_tokens",
              "output_tokens",
              "eda_calls.compile_or_lint",
              "eda_calls.simulation",
              "eda_calls.formal",
              "eda_calls.synthesis",
              "scope_violation_count",
              "trust_event_count"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "output_tokens": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "wall_time_seconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "wall_time_seconds",
        "input_tokens",
        "output_tokens",
        "llm_calls",
        "eda_calls",
        "human_interventions",
        "missing_measurements"
      ],
      "type": "object"
    },
    "result_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "rtlflowbench.result.v2"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "repository_after_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "repository_before_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "status": {
          "enum": [
            "pass",
            "violation",
            "not_available"
          ]
        },
        "violation_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "violations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "violation_count",
        "violations",
        "repository_before_sha256",
        "repository_after_sha256"
      ],
      "type": "object"
    },
    "score": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "type": "object"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "not_scored",
            "scored"
          ]
        },
        "total": {
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "total",
        "dimensions",
        "reason"
      ],
      "type": "object"
    },
    "submission_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "pattern": "^G(0[1-9]|1[0-2])-[a-z0-9-]+$",
      "type": "string"
    },
    "trust_events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "event_type": {
            "enum": [
              "fabricated_claim",
              "scope_violation",
              "hidden_asset_access",
              "network_violation",
              "unsafe_mutation",
              "other"
            ]
          },
          "evidence_refs": {
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "type": "array"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          }
        },
        "required": [
          "event_type",
          "severity",
          "message",
          "evidence_refs"
        ],
        "type": "object"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "invalid_instance",
        "infra_error",
        "invalid_submission",
        "scope_violation",
        "blocked",
        "timeout",
        "compile_error",
        "fail_f2p",
        "fail_p2p",
        "fail_formal",
        "fail_ppa",
        "pass"
      ]
    },
    "verdict_reason": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "task_id",
    "submission_id",
    "document_bindings",
    "run_id",
    "verdict",
    "verdict_reason",
    "oracle_results",
    "raw_metrics",
    "scope",
    "trust_events",
    "resource_usage",
    "score",
    "evidence_manifest",
    "execution_bindings"
  ],
  "title": "RTLFlowBench evaluator result v2 (nullable observations)",
  "type": "object"
}
