{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/external/autochip-run-receipt.v1.json",
  "title": "RTLFlowBench public-only AutoChip development run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_id",
    "task_descriptor_sha256",
    "public_tree_sha256",
    "source",
    "runtime_extensions",
    "input_policy",
    "execution_policy",
    "workflow",
    "attempt",
    "resource_usage",
    "token_accounting",
    "output",
    "failure",
    "private_evaluator_run",
    "benchmark_ready",
    "publication_permitted"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.autochip_run_receipt.v1"},
    "status": {
      "enum": [
        "completed_public_only_not_evaluated",
        "workflow_failure_no_output",
        "control_plane_error"
      ]
    },
    "task_id": {"enum": ["G01-common-fifo-spec"]},
    "task_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "public_tree_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_url",
        "commit",
        "archive_sha256",
        "license_sha256"
      ],
      "properties": {
        "upstream_url": {"const": "https://github.com/shailja-thakur/AutoChip.git"},
        "commit": {"const": "3abe0b606d8819dfe548661b0245b55a1ebab40b"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "license_sha256": {
          "const": "c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4"
        }
      }
    },
    "runtime_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai_compatible_provider_bridge",
        "unused_optional_provider_stubs",
        "public_verdict_bridge"
      ],
      "properties": {
        "openai_compatible_provider_bridge": {"const": true},
        "unused_optional_provider_stubs": {"const": true},
        "public_verdict_bridge": {"const": "golden12-visible-marker-to-mismatch-count-v1"},
        "module_parser_bridge": {"const": "autochip-balanced-module-parser-v1"}
      }
    },
    "input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_packet_only",
        "public_visible_testbench_supplied",
        "golden_testbench_supplied",
        "golden_reference_rtl_supplied",
        "private_evaluator_exposed"
      ],
      "properties": {
        "public_packet_only": {"const": true},
        "public_visible_testbench_supplied": {"const": true},
        "golden_testbench_supplied": {"const": false},
        "golden_reference_rtl_supplied": {"const": false},
        "private_evaluator_exposed": {"const": false}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_surface",
        "provider_traffic_outside_workspace",
        "workspace_network_access_observed"
      ],
      "properties": {
        "feedback_surface": {"const": "public_visible_only"},
        "provider_traffic_outside_workspace": {"const": true},
        "workspace_network_access_observed": {"const": false}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "config_sha256"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]}
          }
        },
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attempt": {"$ref": "#/$defs/attempt"},
    "resource_usage": {"$ref": "#/$defs/resourceUsage"},
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "observed_input_tokens",
        "observed_output_tokens",
        "input_token_observed_call_count",
        "output_token_observed_call_count",
        "token_usage_unobserved_call_count"
      ],
      "properties": {
        "measurement_status": {"enum": ["complete", "partial", "not_available"]},
        "observed_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_token_observed_call_count": {"type": "integer", "minimum": 0},
        "output_token_observed_call_count": {"type": "integer", "minimum": 0},
        "token_usage_unobserved_call_count": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"const": "rtl.sv"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["classification", "exception_class", "message_sha256"],
      "properties": {
        "classification": {"enum": ["workflow_failure_no_output", "control_plane_error"]},
        "exception_class": {"type": ["string", "null"]},
        "message_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "private_evaluator_run": {"const": false},
    "benchmark_ready": {"const": false},
    "publication_permitted": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed_public_only_not_evaluated"}}},
      "then": {
        "properties": {
          "output": {"type": "object"},
          "failure": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "output": {"type": "null"},
          "failure": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "attempt_index", "repeat_group_id", "seed"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "attempt_index": {"type": "integer", "minimum": 1},
        "repeat_group_id": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "input_tokens",
        "output_tokens",
        "llm_calls",
        "eda_calls",
        "human_interventions",
        "missing_measurements"
      ],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "llm_calls": {"type": "integer", "minimum": 0},
        "eda_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compile_or_lint", "simulation", "formal", "synthesis"],
          "properties": {
            "compile_or_lint": {"type": "integer", "minimum": 0},
            "simulation": {"type": "integer", "minimum": 0},
            "formal": {"type": "integer", "minimum": 0},
            "synthesis": {"type": "integer", "minimum": 0}
          }
        },
        "human_interventions": {"type": "integer", "minimum": 0},
        "missing_measurements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["input_tokens", "output_tokens"]}
        }
      }
    }
  }
}
