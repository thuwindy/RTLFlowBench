{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/adapter/chipflow-usage-events.v1.json",
  "title": "ChipFlow benchmark usage event ledger",
  "description": "Typed accounting events derived from persisted ChipFlow artifacts. network_attempt means a task-workspace/tool-sandbox network attempt; sanctioned model-provider control-plane traffic is represented by llm_call instead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chipflow_run_id",
    "collection_evidence_refs",
    "network_monitor",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.chipflow_usage_events.v1"
    },
    "chipflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "collection_evidence_refs": {
      "description": "Canonical source artifacts that prove complete collection, including zero-event EDA, HITL, and task-workspace network observations.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "network_monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "method"
      ],
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/relativePath"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "input_tokens",
          "output_tokens",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "llm_call",
              "eda_compile_or_lint",
              "eda_simulation",
              "eda_formal",
              "eda_synthesis",
              "human_intervention",
              "network_attempt"
            ]
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "llm_call"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "else": {
              "properties": {
                "input_tokens": {
                  "type": "null"
                },
                "output_tokens": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
