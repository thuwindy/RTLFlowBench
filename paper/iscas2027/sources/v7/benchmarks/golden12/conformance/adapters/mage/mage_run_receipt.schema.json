{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/external/mage-run-receipt.v1.json",
  "title": "RTLFlowBench public-only MAGE run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_id",
    "task_descriptor_sha256",
    "public_tree_sha256",
    "source",
    "mode",
    "runtime_extensions",
    "input_policy",
    "execution_policy",
    "workflow",
    "attempt",
    "resource_usage",
    "token_accounting",
    "output",
    "failure",
    "private_evaluator_run",
    "benchmark_ready",
    "publication_permitted"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.mage_run_receipt.v1"},
    "status": {
      "enum": [
        "completed_public_only_not_evaluated",
        "workflow_failure_no_output",
        "control_plane_error"
      ]
    },
    "task_id": {
      "enum": [
        "G01-common-fifo-spec",
        "G02-common-rr-arbiter-spec"
      ]
    },
    "task_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "public_tree_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_url", "commit", "license_sha256"],
      "properties": {
        "upstream_url": {"const": "https://github.com/stable-lab/MAGE.git"},
        "commit": {"const": "90c96366c518d32bd7b81703bdef3cc46eeaeaf9"},
        "license_sha256": {
          "const": "aa5a4458be46e4e17ac0a5d0da13213cc1058bbcaaa53377852e448078b80091"
        }
      }
    },
    "mode": {
      "enum": [
        "development_ablation_syntax_only",
        "full_multi_agent"
      ]
    },
    "runtime_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai_like_bridge", "tokenizer_mapping"],
      "properties": {
        "openai_like_bridge": {"const": "llama-index-llms-openai-like@0.7.2"},
        "tokenizer_mapping": {"const": "o200k_base"}
      }
    },
    "input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_packet_only",
        "golden_testbench_supplied",
        "golden_reference_rtl_supplied",
        "private_evaluator_exposed"
      ],
      "properties": {
        "public_packet_only": {"const": true},
        "golden_testbench_supplied": {"const": false},
        "golden_reference_rtl_supplied": {"const": false},
        "private_evaluator_exposed": {"const": false}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_golden_tb_in_mage",
        "provider_traffic_outside_workspace",
        "workspace_network_access_observed"
      ],
      "properties": {
        "use_golden_tb_in_mage": {"const": false},
        "provider_traffic_outside_workspace": {"const": true},
        "workspace_network_access_observed": {"const": false}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "config_sha256"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]}
          }
        },
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attempt": {"$ref": "#/$defs/attempt"},
    "resource_usage": {"$ref": "#/$defs/resourceUsage"},
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "observed_input_tokens",
        "observed_output_tokens",
        "input_token_observed_call_count",
        "output_token_observed_call_count",
        "token_usage_unobserved_call_count"
      ],
      "properties": {
        "measurement_status": {"enum": ["complete", "partial", "not_available"]},
        "observed_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_token_observed_call_count": {"type": "integer", "minimum": 0},
        "output_token_observed_call_count": {"type": "integer", "minimum": 0},
        "token_usage_unobserved_call_count": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"const": "rtl.sv"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["classification", "exception_class", "message_sha256"],
      "properties": {
        "classification": {
          "enum": ["workflow_failure_no_output", "control_plane_error"]
        },
        "exception_class": {"type": ["string", "null"]},
        "message_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "private_evaluator_run": {"const": false},
    "benchmark_ready": {"const": false},
    "publication_permitted": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "completed_public_only_not_evaluated"}
        }
      },
      "then": {
        "properties": {
          "output": {"type": "object"},
          "failure": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "output": {"type": "null"},
          "failure": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "attempt_index", "repeat_group_id", "seed"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "attempt_index": {"type": "integer", "minimum": 1},
        "repeat_group_id": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "input_tokens",
        "output_tokens",
        "llm_calls",
        "eda_calls",
        "human_interventions",
        "missing_measurements"
      ],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "llm_calls": {"type": "integer", "minimum": 0},
        "eda_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compile_or_lint", "simulation", "formal", "synthesis"],
          "properties": {
            "compile_or_lint": {"type": "integer", "minimum": 0},
            "simulation": {"type": "integer", "minimum": 0},
            "formal": {"type": "integer", "minimum": 0},
            "synthesis": {"type": "integer", "minimum": 0}
          }
        },
        "human_interventions": {"type": "integer", "minimum": 0},
        "missing_measurements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["input_tokens", "output_tokens"]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"input_tokens": {"type": "null"}}},
          "then": {"properties": {"missing_measurements": {"contains": {"const": "input_tokens"}}}}
        },
        {
          "if": {"properties": {"output_tokens": {"type": "null"}}},
          "then": {"properties": {"missing_measurements": {"contains": {"const": "output_tokens"}}}}
        }
      ]
    }
  }
}
