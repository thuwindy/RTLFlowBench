{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.local/schemas/yosys-equivalence-contract-v1.json",
  "title": "RTLFlowBench public Yosys equivalence contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "top_module",
    "language",
    "source_paths",
    "parameters",
    "sequential_depth",
    "max_source_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.yosys_equivalence_contract.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "top_module": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "language": {
      "enum": ["verilog_2005", "systemverilog"]
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:v|sv)$"
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"type": "integer"},
          {"type": "string", "minLength": 1}
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
      }
    },
    "sequential_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    }
  }
}
