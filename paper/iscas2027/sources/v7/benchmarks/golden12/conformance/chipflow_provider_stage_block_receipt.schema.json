{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/chipflow-provider-stage-block-receipt.v2.json",
  "title": "RTLFlowBench stage-aware ChipFlow provider infrastructure BLOCK receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "observed_at",
    "status",
    "attempt",
    "evidence",
    "public_input_binding",
    "workspace_observation",
    "workflow_progress",
    "resource_usage",
    "runtime_source_lock",
    "server_source_authority_guard",
    "readiness_impact",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.chipflow_provider_stage_block_receipt.v2"
    },
    "task_id": {
      "type": "string",
      "pattern": "^G(0[1-9]|1[0-2])-[a-z0-9-]+$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "blocked_model_provider_infra_after_partial_workflow"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "exit_code",
        "terminal_status",
        "terminal_stage",
        "failed_workflow_stage",
        "failed_dispatch_stage",
        "stable_error_class",
        "provider_http_status",
        "provider_error_code",
        "effective_model_alias",
        "dispatch_result_count",
        "completed_dispatch_count",
        "blocked_dispatch_count"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer", "not": {"const": 0}},
        "terminal_status": {"const": "blocked"},
        "terminal_stage": {"const": "BLOCKED"},
        "failed_workflow_stage": {
          "enum": ["design", "review", "judge", "patch_plan"]
        },
        "failed_dispatch_stage": {"type": "string", "minLength": 1},
        "stable_error_class": {
          "const": "model_provider_infra_error: quota_or_billing_unavailable"
        },
        "provider_http_status": {"enum": [402, 429]},
        "provider_error_code": {
          "enum": [
            "insufficient_balance_or_quota",
            "rate_limit_or_quota_exhausted"
          ]
        },
        "effective_model_alias": {"type": "string", "minLength": 1},
        "dispatch_result_count": {"type": "integer", "minimum": 1},
        "completed_dispatch_count": {"type": "integer", "minimum": 0},
        "blocked_dispatch_count": {"const": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_root_locator",
        "run_root_locator",
        "orchestration_summary",
        "runtime_config",
        "runtime_context",
        "native_runtime_manifest",
        "approval_decisions",
        "raw_command_logs",
        "dispatch_results",
        "produced_artifacts",
        "raw_provider_response_copied"
      ],
      "properties": {
        "evidence_root_locator": {"type": "string", "minLength": 1},
        "run_root_locator": {"type": "string", "minLength": 1},
        "orchestration_summary": {"$ref": "#/$defs/runFileEvidence"},
        "runtime_config": {"$ref": "#/$defs/runFileEvidence"},
        "runtime_context": {"$ref": "#/$defs/runFileEvidence"},
        "native_runtime_manifest": {
          "$ref": "#/$defs/nativeRuntimeManifestEvidence"
        },
        "approval_decisions": {"$ref": "#/$defs/emptyRunFileEvidence"},
        "raw_command_logs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceFileEvidence"}
        },
        "dispatch_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dispatchEvidence"}
        },
        "produced_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/runFileEvidence"}
        },
        "raw_provider_response_copied": {"const": false}
      }
    },
    "public_input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "file_count",
        "total_bytes",
        "path_count",
        "mismatch_count",
        "contains_private_or_hidden_path",
        "runtime_config_matches_context"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "path_count": {"type": "integer", "minimum": 1},
        "mismatch_count": {"const": 0},
        "contains_private_or_hidden_path": {"const": false},
        "runtime_config_matches_context": {"const": true}
      }
    },
    "workspace_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_mode",
        "workflow_workspace_path",
        "terminal_file_count",
        "terminal_tree_sha256",
        "main_workspace_mutation_observed",
        "preapproval_sandbox_separate",
        "private_evaluator_exposed"
      ],
      "properties": {
        "source_mode": {"const": "blank_scaffold"},
        "workflow_workspace_path": {"$ref": "#/$defs/relativePath"},
        "terminal_file_count": {"const": 0},
        "terminal_tree_sha256": {"$ref": "#/$defs/sha256"},
        "main_workspace_mutation_observed": {"const": false},
        "preapproval_sandbox_separate": {"type": "boolean"},
        "private_evaluator_exposed": {"const": false}
      }
    },
    "workflow_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_spec_produced",
        "completed_critic_count",
        "judge_decision",
        "judge_accept_observed",
        "patch_plan_candidate_count",
        "preapproval_machine_gates",
        "approval_observed",
        "safe_executor_run_count",
        "post_executor_verification_run_count",
        "private_evaluator_run_count",
        "neutral_export_count",
        "benchmark_pass_claimed",
        "score_claimed",
        "ppa_claimed"
      ],
      "properties": {
        "design_spec_produced": {"type": "boolean"},
        "completed_critic_count": {"type": "integer", "minimum": 0},
        "judge_decision": {"type": ["string", "null"]},
        "judge_accept_observed": {"type": "boolean"},
        "patch_plan_candidate_count": {"type": "integer", "minimum": 0},
        "preapproval_machine_gates": {
          "type": "array",
          "items": {"$ref": "#/$defs/machineGateEvidence"}
        },
        "approval_observed": {"const": false},
        "safe_executor_run_count": {"const": 0},
        "post_executor_verification_run_count": {"const": 0},
        "private_evaluator_run_count": {"const": 0},
        "neutral_export_count": {"const": 0},
        "benchmark_pass_claimed": {"const": false},
        "score_claimed": {"const": false},
        "ppa_claimed": {"const": false}
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "maximum_resident_set_kib",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "llm_dispatches",
        "token_accounted_dispatches",
        "failed_unaccounted_dispatches",
        "preapproval_machine_gate_runs",
        "post_executor_eda_runs",
        "human_interventions",
        "missing_measurements"
      ],
      "properties": {
        "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "maximum_resident_set_kib": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "llm_dispatches": {"type": "integer", "minimum": 1},
        "token_accounted_dispatches": {"type": "integer", "minimum": 0},
        "failed_unaccounted_dispatches": {"const": 1},
        "preapproval_machine_gate_runs": {"type": "integer", "minimum": 0},
        "post_executor_eda_runs": {"const": 0},
        "human_interventions": {"const": 0},
        "missing_measurements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["wall_time_seconds", "maximum_resident_set_kib", "failed_dispatch_tokens"]
          }
        }
      }
    },
    "runtime_source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_count", "components", "canonical_sha256"],
      "properties": {
        "component_count": {"type": "integer", "minimum": 1},
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "server_source_authority_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "branch",
        "dirty_entry_count",
        "porcelain_sha256",
        "before_after_equal",
        "mode",
        "modified"
      ],
      "properties": {
        "head": {"$ref": "#/$defs/gitObjectId"},
        "branch": {"type": "string", "minLength": 1},
        "dirty_entry_count": {"type": "integer", "minimum": 0},
        "porcelain_sha256": {"$ref": "#/$defs/sha256"},
        "before_after_equal": {"const": true},
        "mode": {"const": "read_only"},
        "modified": {"const": false}
      }
    },
    "readiness_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_current_source_attempt_observed",
        "verified_completion_observed",
        "provider_healthy_retry_required",
        "current_runtime_expected_pass_observed",
        "current_runtime_multirun_complete",
        "benchmark_ready",
        "chipflow_adapter_ready"
      ],
      "properties": {
        "fresh_current_source_attempt_observed": {"const": true},
        "verified_completion_observed": {"const": false},
        "provider_healthy_retry_required": {"const": true},
        "current_runtime_expected_pass_observed": {"const": false},
        "current_runtime_multirun_complete": {"const": false},
        "benchmark_ready": {"const": false},
        "chipflow_adapter_ready": {"const": false}
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileEvidenceBase": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runFileEvidence": {
      "allOf": [
        {"$ref": "#/$defs/fileEvidenceBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "root"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "root": {"const": "run"}
          }
        }
      ]
    },
    "evidenceFileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "root"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "root": {"const": "evidence"}
      }
    },
    "nativeRuntimeManifestEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "root", "run_manifest_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "root": {"const": "run"},
        "run_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "emptyRunFileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "root", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "root": {"const": "run"},
        "bytes": {"const": 0}
      }
    },
    "dispatchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "root",
        "stage",
        "status",
        "token_usage_record_count",
        "raw_response"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "root": {"const": "run"},
        "stage": {"type": "string", "minLength": 1},
        "status": {"enum": ["completed", "blocked"]},
        "token_usage_record_count": {"type": "integer", "minimum": 0},
        "raw_response": {"$ref": "#/$defs/runFileEvidence"}
      }
    },
    "machineGateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_sha256",
        "candidate_plan",
        "eda_result",
        "visible_result",
        "eda_status",
        "visible_verdict",
        "workspace_mutated",
        "command_count"
      ],
      "properties": {
        "gate_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_plan": {"$ref": "#/$defs/runFileEvidence"},
        "eda_result": {"$ref": "#/$defs/runFileEvidence"},
        "visible_result": {"$ref": "#/$defs/runFileEvidence"},
        "eda_status": {"enum": ["pass", "fail", "infra_error"]},
        "visible_verdict": {
          "enum": ["pass", "functional_fail", "compile_error", "timeout", "infra_error"]
        },
        "workspace_mutated": {"const": false},
        "command_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
