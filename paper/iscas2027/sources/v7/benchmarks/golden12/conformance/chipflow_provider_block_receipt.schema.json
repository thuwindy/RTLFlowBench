{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/chipflow-provider-block-receipt.v1.json",
  "title": "RTLFlowBench ChipFlow pre-DesignSpec provider BLOCK receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "observed_at",
    "status",
    "attempt",
    "evidence",
    "repository_projection",
    "runtime_source_lock",
    "safety_observations",
    "resource_usage",
    "readiness_impact",
    "server_source_authority_guard",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.chipflow_provider_block_receipt.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^G(0[1-9]|1[0-2])-[a-z0-9-]+$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "blocked_model_provider_infra_before_design_spec"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "exit_code",
        "terminal_status",
        "terminal_stage",
        "stable_error_class",
        "provider_http_status",
        "provider_error_code",
        "effective_model_alias",
        "model_dispatch_attempts"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer", "not": {"const": 0}},
        "terminal_status": {"const": "blocked"},
        "terminal_stage": {"const": "BLOCKED"},
        "stable_error_class": {
          "const": "model_provider_infra_error: quota_or_billing_unavailable"
        },
        "provider_http_status": {"const": 402},
        "provider_error_code": {"const": "insufficient_balance_or_quota"},
        "effective_model_alias": {"type": "string", "minLength": 1},
        "model_dispatch_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_locator",
        "orchestration_summary",
        "runtime_config",
        "native_runtime_manifest",
        "raw_command_log",
        "projection_manifest",
        "projection_receipt"
      ],
      "properties": {
        "root_locator": {"type": "string", "minLength": 1},
        "orchestration_summary": {"$ref": "#/$defs/fileEvidence"},
        "runtime_config": {"$ref": "#/$defs/fileEvidence"},
        "raw_command_log": {"$ref": "#/$defs/fileEvidence"},
        "projection_manifest": {"$ref": "#/$defs/fileEvidence"},
        "projection_receipt": {"$ref": "#/$defs/fileEvidence"},
        "native_runtime_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "run_manifest_sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "run_manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "repository_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256",
        "manifest_sha256",
        "projection_digest",
        "projected_file_count",
        "projected_paths",
        "workspace_file_count",
        "workspace_mismatch_count",
        "contains_evaluator_assets",
        "workflow_files_writable",
        "redistribution_review_complete"
      ],
      "properties": {
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "projection_digest": {"$ref": "#/$defs/sha256"},
        "projected_file_count": {"type": "integer", "minimum": 1},
        "projected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "workspace_file_count": {"type": "integer", "minimum": 1},
        "workspace_mismatch_count": {"const": 0},
        "contains_evaluator_assets": {"const": false},
        "workflow_files_writable": {"const": false},
        "redistribution_review_complete": {"type": "boolean"}
      }
    },
    "runtime_source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_count", "components", "canonical_sha256"],
      "properties": {
        "component_count": {"type": "integer", "minimum": 1},
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "safety_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_spec_produced",
        "judge_accept_observed",
        "approval_observed",
        "safe_executor_run_count",
        "workspace_mutation_count",
        "eda_run_count",
        "private_evaluator_run_count",
        "neutral_export_count",
        "benchmark_pass_claimed",
        "score_claimed",
        "ppa_claimed",
        "task_workspace_network_access_observed"
      ],
      "properties": {
        "design_spec_produced": {"const": false},
        "judge_accept_observed": {"const": false},
        "approval_observed": {"const": false},
        "safe_executor_run_count": {"const": 0},
        "workspace_mutation_count": {"const": 0},
        "eda_run_count": {"const": 0},
        "private_evaluator_run_count": {"const": 0},
        "neutral_export_count": {"const": 0},
        "benchmark_pass_claimed": {"const": false},
        "score_claimed": {"const": false},
        "ppa_claimed": {"const": false},
        "task_workspace_network_access_observed": {"type": "null"}
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "input_tokens",
        "output_tokens",
        "llm_calls",
        "eda_calls",
        "human_interventions",
        "missing_measurements"
      ],
      "properties": {
        "wall_time_seconds": {"type": "null"},
        "input_tokens": {"type": "null"},
        "output_tokens": {"type": "null"},
        "llm_calls": {"type": "integer", "minimum": 1},
        "eda_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compile_or_lint", "simulation", "formal", "synthesis"],
          "properties": {
            "compile_or_lint": {"const": 0},
            "simulation": {"const": 0},
            "formal": {"const": 0},
            "synthesis": {"const": 0}
          }
        },
        "human_interventions": {"const": 0},
        "missing_measurements": {
          "type": "array",
          "const": ["wall_time_seconds", "input_tokens", "output_tokens"]
        }
      }
    },
    "readiness_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_current_source_attempt_observed",
        "verified_completion_observed",
        "provider_healthy_retry_required",
        "current_runtime_multirun_complete",
        "benchmark_ready",
        "chipflow_adapter_ready"
      ],
      "properties": {
        "fresh_current_source_attempt_observed": {"const": true},
        "verified_completion_observed": {"const": false},
        "provider_healthy_retry_required": {"const": true},
        "current_runtime_multirun_complete": {"const": false},
        "benchmark_ready": {"const": false},
        "chipflow_adapter_ready": {"const": false}
      }
    },
    "server_source_authority_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "branch",
        "dirty_entry_count",
        "porcelain_sha256",
        "mode",
        "modified"
      ],
      "properties": {
        "head": {"$ref": "#/$defs/gitObjectId"},
        "branch": {"type": "string", "minLength": 1},
        "dirty_entry_count": {"type": "integer", "minimum": 0},
        "porcelain_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "read_only"},
        "modified": {"const": false}
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
