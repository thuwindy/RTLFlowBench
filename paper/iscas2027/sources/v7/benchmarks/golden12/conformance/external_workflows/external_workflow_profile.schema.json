{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/external-workflow-profile.v1.json",
  "title": "RTLFlowBench external workflow intake profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "upstream",
    "source_intake",
    "environment_candidate",
    "actual_run_candidate",
    "capability_projection",
    "golden12_boundary",
    "rights",
    "integration_blockers",
    "readiness",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.external_workflow_profile.v1"},
    "status": {"const": "source_verified_integration_blocked"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "url", "commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "commit": {"$ref": "#/$defs/sha256orGit"}
      }
    },
    "source_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "file_count", "submodules_initialized"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "submodules_initialized": {"const": false}
      }
    },
    "environment_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "status",
        "development_preflight_passed",
        "same_server_reproduced",
        "cross_host_reproduced",
        "release_frozen"
      ],
      "properties": {
        "path": {
          "const": "benchmarks/golden12/conformance/external_workflows/mage_environment_candidate.json"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {
          "const": "same_server_development_environment_reproduced_not_frozen"
        },
        "development_preflight_passed": {"const": true},
        "same_server_reproduced": {"const": true},
        "cross_host_reproduced": {"const": false},
        "release_frozen": {"const": false}
      }
    },
    "actual_run_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "status",
        "task_id",
        "airtl_run_observed",
        "verdict",
        "adapter_ready",
        "benchmark_ready",
        "publishable_cohort_eligible"
      ],
      "properties": {
        "path": {
          "const": "benchmarks/golden12/conformance/external_workflows/mage_g01_development_run_receipt.json"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "completed_evaluated_fail_f2p_development_only"},
        "task_id": {"const": "G01-common-fifo-spec"},
        "airtl_run_observed": {"const": true},
        "verdict": {"const": "fail_f2p"},
        "adapter_ready": {"const": false},
        "benchmark_ready": {"const": false},
        "publishable_cohort_eligible": {"const": false}
      }
    },
    "capability_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_families", "supported_tasks", "not_demonstrated_families"],
      "properties": {
        "supported_families": {
          "type": "array",
          "const": ["spec_to_rtl"]
        },
        "supported_tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^G(0[1-9]|1[0-2])-[a-z0-9-]+$"}
        },
        "not_demonstrated_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "golden12_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "golden_tb_path",
        "golden_rtl_blackbox_path",
        "private_evaluator_mounted",
        "verilog_eval_submodule_required",
        "provider_eda_network_separation_proven"
      ],
      "properties": {
        "golden_tb_path": {"type": "null"},
        "golden_rtl_blackbox_path": {"type": "null"},
        "private_evaluator_mounted": {"const": false},
        "verilog_eval_submodule_required": {"const": false},
        "provider_eda_network_separation_proven": {"const": true}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "license_file", "package_classifier", "declarations_consistent", "redistribution_permitted"],
      "properties": {
        "status": {"const": "pending_independent_review"},
        "license_file": {"type": "string", "minLength": 1},
        "package_classifier": {"type": "string", "minLength": 1},
        "declarations_consistent": {"const": false},
        "redistribution_permitted": {"type": "null"}
      }
    },
    "integration_blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_environment_ready",
        "submission_adapter_ready",
        "publishable_cohort_eligible",
        "airtl_run_observed",
        "benchmark_pass_observed"
      ],
      "properties": {
        "dependency_environment_ready": {"const": false},
        "submission_adapter_ready": {"const": false},
        "publishable_cohort_eligible": {"const": false},
        "airtl_run_observed": {"const": true},
        "benchmark_pass_observed": {"const": false}
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256orGit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
