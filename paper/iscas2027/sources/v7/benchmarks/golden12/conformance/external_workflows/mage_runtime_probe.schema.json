{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/mage-runtime-probe.v1.json",
  "title": "RTLFlowBench MAGE provider-free runtime probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "status",
    "source_binding",
    "image_digest",
    "checks",
    "python",
    "package_versions",
    "imported_modules",
    "tools",
    "network_interfaces",
    "provider_environment_names_present",
    "forbidden_roots_present",
    "airtl_run_observed",
    "provider_call_observed",
    "provider_eda_network_separation_proven",
    "private_evaluator_run",
    "rtl_verdict_produced",
    "benchmark_ready",
    "adapter_ready",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.mage_runtime_probe.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail"]},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_modules_imported",
        "eda_tools_exit_zero",
        "network_only_loopback",
        "root_filesystem_read_only",
        "tmpfs_writable",
        "provider_credentials_absent",
        "forbidden_private_roots_absent"
      ],
      "properties": {
        "required_modules_imported": {"type": "boolean"},
        "eda_tools_exit_zero": {"type": "boolean"},
        "network_only_loopback": {"type": "boolean"},
        "root_filesystem_read_only": {"type": "boolean"},
        "tmpfs_writable": {"type": "boolean"},
        "provider_credentials_absent": {"type": "boolean"},
        "forbidden_private_roots_absent": {"type": "boolean"}
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"}
      }
    },
    "package_versions": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "imported_modules": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iverilog", "vvp", "yosys"],
      "properties": {
        "iverilog": {"$ref": "#/$defs/tool"},
        "vvp": {"$ref": "#/$defs/tool"},
        "yosys": {"$ref": "#/$defs/tool"}
      }
    },
    "network_interfaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "provider_environment_names_present": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_roots_present": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "airtl_run_observed": {"const": false},
    "provider_call_observed": {"const": false},
    "provider_eda_network_separation_proven": {"const": false},
    "private_evaluator_run": {"const": false},
    "rtl_verdict_produced": {"const": false},
    "benchmark_ready": {"const": false},
    "adapter_ready": {"const": false},
    "excluded_claims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "version_line"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"type": "integer"},
        "version_line": {"type": ["string", "null"]}
      }
    }
  }
}
