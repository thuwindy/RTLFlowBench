{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/external-workflow-source-preflight.v1.json",
  "title": "RTLFlowBench provider-free external workflow source preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "status",
    "workflow",
    "source_binding",
    "entrypoint",
    "dependencies",
    "boundary",
    "host_observation",
    "checks",
    "readiness",
    "blockers",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.external_workflow_source_preflight.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "source_preflight_pass_environment_blocked"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "display_name",
        "repository",
        "commit",
        "source_locator",
        "source_archive_locator"
      ],
      "properties": {
        "workflow_id": {"enum": ["verilogcoder", "hdlagent"]},
        "display_name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_locator": {"$ref": "#/$defs/locator"},
        "source_archive_locator": {"$ref": "#/$defs/locator"}
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256",
        "recreated_archive_sha256",
        "tracked_manifest_sha256",
        "worktree_clean",
        "submodules_present"
      ],
      "properties": {
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "recreated_archive_sha256": {"$ref": "#/$defs/sha256"},
        "tracked_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "worktree_clean": {"const": true},
        "submodules_present": {"const": false}
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "metadata_path",
        "metadata_kind",
        "ast_parse_passed",
        "executed"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "metadata_path": {"type": "string", "minLength": 1},
        "metadata_kind": {"enum": ["setuptools_ast", "poetry_toml"]},
        "ast_parse_passed": {"const": true},
        "executed": {"const": false}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_constraint",
        "items",
        "dependency_count",
        "exact_pin_count",
        "fully_exact_pinned",
        "mutable_vcs_dependencies",
        "resolved_lock_complete",
        "wheelhouse_complete"
      ],
      "properties": {
        "python_constraint": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "dependency_count": {"type": "integer", "minimum": 1},
        "exact_pin_count": {"type": "integer", "minimum": 0},
        "fully_exact_pinned": {"type": "boolean"},
        "mutable_vcs_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "resolved_lock_complete": {"const": false},
        "wheelhouse_complete": {"const": false}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_testbench_input",
        "hardcoded_task_selection",
        "external_benchmark_alias_present",
        "public_visible_only_adapter_required",
        "external_benchmark_alias_must_be_forbidden",
        "golden_reference_input_permitted",
        "private_evaluator_mount_permitted"
      ],
      "properties": {
        "requires_testbench_input": {"type": "boolean"},
        "hardcoded_task_selection": {"type": "boolean"},
        "external_benchmark_alias_present": {"type": "boolean"},
        "public_visible_only_adapter_required": {"const": true},
        "external_benchmark_alias_must_be_forbidden": {"type": "boolean"},
        "golden_reference_input_permitted": {"const": false},
        "private_evaluator_mount_permitted": {"const": false}
      }
    },
    "host_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "podman",
        "iverilog",
        "yosys",
        "verilator",
        "symbiyosys",
        "host_tools_are_frozen_environment"
      ],
      "properties": {
        "python": {"$ref": "#/$defs/tool"},
        "podman": {"$ref": "#/$defs/tool"},
        "iverilog": {"$ref": "#/$defs/tool"},
        "yosys": {"$ref": "#/$defs/tool"},
        "verilator": {"$ref": "#/$defs/tool"},
        "symbiyosys": {"$ref": "#/$defs/tool"},
        "host_tools_are_frozen_environment": {"const": false}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit_matches",
        "worktree_clean",
        "submodule_status_empty",
        "source_archive_matches",
        "recreated_archive_matches",
        "tracked_manifest_matches",
        "entrypoint_ast_parses",
        "dependency_metadata_parsed"
      ],
      "properties": {
        "source_commit_matches": {"const": true},
        "worktree_clean": {"const": true},
        "submodule_status_empty": {"const": true},
        "source_archive_matches": {"const": true},
        "recreated_archive_matches": {"const": true},
        "tracked_manifest_matches": {"const": true},
        "entrypoint_ast_parses": {"const": true},
        "dependency_metadata_parsed": {"const": true}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_preflight_passed",
        "dependency_lock_frozen",
        "environment_reproduced",
        "adapter_conformance_passed",
        "airtl_run_observed",
        "private_evaluator_run",
        "rtl_verdict_produced",
        "official_attempts_permitted",
        "publication_permitted"
      ],
      "properties": {
        "source_preflight_passed": {"const": true},
        "dependency_lock_frozen": {"const": false},
        "environment_reproduced": {"const": false},
        "adapter_conformance_passed": {"const": false},
        "airtl_run_observed": {"const": false},
        "private_evaluator_run": {"const": false},
        "rtl_verdict_produced": {"const": false},
        "official_attempts_permitted": {"const": false},
        "publication_permitted": {"const": false}
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator": {
      "type": "string",
      "pattern": "^SERVER26:rtlflowbench/",
      "not": {"pattern": "(/home/|/Users/)"}
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "constraint", "exact_pin", "mutable_vcs_reference"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "exact_pin": {"type": "boolean"},
        "mutable_vcs_reference": {"type": "boolean"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "version_line"],
      "properties": {
        "available": {"type": "boolean"},
        "version_line": {"type": ["string", "null"]}
      }
    }
  }
}
