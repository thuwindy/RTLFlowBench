{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.invalid/schemas/external-runtime-environment-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "observed_at",
    "workflow",
    "source_snapshot",
    "dependency_environment",
    "container",
    "preflight",
    "evidence",
    "claims",
    "remaining_gates"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.external_runtime_environment_receipt.v1"},
    "status": {"const": "same_server_deterministic_runtime_reproduced_not_release_frozen"},
    "observed_at": {"type": "string", "format": "date-time"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "display_name", "commit", "tracked_manifest_sha256"],
      "properties": {
        "workflow_id": {"enum": ["verilogcoder", "hdlagent"]},
        "display_name": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tracked_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "manifest_sha256", "tracked_python_cache_count", "tracked_python_cache_execution"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tracked_python_cache_count": {"type": "integer", "minimum": 0},
        "tracked_python_cache_execution": {"const": false}
      }
    },
    "dependency_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_lock_sha256", "wheelhouse_manifest_sha256", "wheelhouse_distribution_count", "two_offline_rebuilds_passed", "two_deterministic_overlay_trees_equal", "overlay_file_count", "overlay_python_cache_count"],
      "properties": {
        "requirements_lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheelhouse_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "wheelhouse_distribution_count": {"type": "integer", "minimum": 1},
        "two_offline_rebuilds_passed": {"const": true},
        "two_deterministic_overlay_trees_equal": {"const": true},
        "overlay_file_count": {"type": "integer", "minimum": 1},
        "overlay_python_cache_count": {"const": 0}
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_base", "system_runtime_source_bound", "build_network", "build_no_cache", "build_omit_history", "build_timestamp", "image_id", "image_digest", "size_bytes", "two_build_identity_equal", "context_file_count"],
      "properties": {
        "public_base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image_id", "image_digest"],
          "properties": {
            "image_id": {"$ref": "#/$defs/sha256"},
            "image_digest": {"$ref": "#/$defs/image_digest"}
          }
        },
        "system_runtime_source_bound": {"const": true},
        "build_network": {"const": "none"},
        "build_no_cache": {"const": true},
        "build_omit_history": {"const": true},
        "build_timestamp": {"const": 0},
        "image_id": {"$ref": "#/$defs/sha256"},
        "image_digest": {"$ref": "#/$defs/image_digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "two_build_identity_equal": {"const": true},
        "context_file_count": {"type": "integer", "minimum": 1}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_binding", "core_import", "launcher_help", "network", "iverilog_version", "yosys_version", "benchmark_sensitive_path_scan_empty", "benchmark_sensitive_path_matches_sha256"],
      "properties": {
        "status": {"const": "pass"},
        "source_binding": {"const": true},
        "core_import": {"const": true},
        "launcher_help": {"const": true},
        "network": {"const": "none"},
        "iverilog_version": {"type": "string", "minLength": 1},
        "yosys_version": {"type": "string", "minLength": 1},
        "benchmark_sensitive_path_scan_empty": {"const": true},
        "benchmark_sensitive_path_matches_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "artifacts"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact", "sha256"],
              "properties": {
                "artifact": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_reproducible_same_server", "cross_host_reproduced", "release_frozen", "provider_call_observed", "airtl_run_observed", "hidden_evaluator_run", "rtl_verdict_produced", "adapter_ready", "benchmark_ready"],
      "properties": {
        "environment_reproducible_same_server": {"const": true},
        "cross_host_reproduced": {"const": false},
        "release_frozen": {"const": false},
        "provider_call_observed": {"const": false},
        "airtl_run_observed": {"const": false},
        "hidden_evaluator_run": {"const": false},
        "rtl_verdict_produced": {"const": false},
        "adapter_ready": {"const": false},
        "benchmark_ready": {"const": false}
      }
    },
    "remaining_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
