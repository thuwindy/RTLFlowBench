{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schemas/provider-broker-call.v1.json",
  "title": "RTLFlowBench provider broker call receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_index",
    "provider",
    "model",
    "endpoint_allowlist_match",
    "decoding_contract_match",
    "request",
    "response",
    "usage",
    "wall_time_seconds",
    "credential_recorded"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.provider_broker_call.v1"},
    "request_index": {"type": "integer", "minimum": 1},
    "provider": {"const": "deepseek"},
    "model": {"type": "string", "minLength": 1},
    "endpoint_allowlist_match": {"const": true},
    "decoding_contract_match": {"const": true},
    "request": {"$ref": "#/$defs/redactedPayload"},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "raw_content_recorded",
        "http_status",
        "error_class"
      ],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "raw_content_recorded": {"const": false},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "error_class": {"type": ["string", "null"]}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "credential_recorded": {"const": false}
  },
  "$defs": {
    "redactedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "raw_content_recorded"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "raw_content_recorded": {"const": false}
      }
    }
  }
}
