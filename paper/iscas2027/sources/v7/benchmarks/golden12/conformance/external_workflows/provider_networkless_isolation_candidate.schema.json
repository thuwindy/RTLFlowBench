{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schemas/provider-networkless-isolation-candidate.v1.json",
  "title": "RTLFlowBench networkless provider isolation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "status",
    "model_control",
    "source",
    "evidence",
    "isolation",
    "readiness",
    "remaining_blockers",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.provider_networkless_isolation_candidate.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "development_actual_workflow_isolation_proven_not_admitted"},
    "model_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "temperature", "thinking_mode", "candidate_sha256", "frozen"],
      "properties": {
        "provider": {"const": "deepseek"},
        "model": {"const": "deepseek-v4-pro"},
        "temperature": {"const": 0},
        "thinking_mode": {"const": "disabled"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"},
      "required": [
        "provider_broker_sha256",
        "provider_tcp_shim_sha256",
        "provider_call_schema_sha256",
        "source_regression_test_sha256"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_preflight", "networkless_smoke", "actual_workflow", "post_run_source_changes", "source_regression"],
      "properties": {
        "provider_preflight": {"$ref": "#/$defs/evidenceRef"},
        "networkless_smoke": {"$ref": "#/$defs/evidenceRef"},
        "actual_workflow": {
          "allOf": [
            {"$ref": "#/$defs/evidenceRef"},
            {
              "type": "object",
              "properties": {
                "development_outcome": {"const": "FAIL"},
                "official_benchmark_outcome": {"type": "null"},
                "provider_call_receipt_count": {"const": 64},
                "workflow_attempted_llm_calls": {"const": 65},
                "rtl_output_observed": {"const": false},
                "eda_call_count": {"const": 0}
              },
              "required": ["development_outcome", "official_benchmark_outcome", "provider_call_receipt_count", "workflow_attempted_llm_calls", "rtl_output_observed", "eda_call_count"]
            }
          ]
        },
        "post_run_source_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution_sha256", "current_sha256", "classification", "affects_execution_semantics", "execution_source_preserved"],
          "properties": {
            "execution_sha256": {"$ref": "#/$defs/sha256"},
            "current_sha256": {"$ref": "#/$defs/sha256"},
            "classification": {"const": "unused_import_removal_no_execution_semantics"},
            "affects_execution_semantics": {"const": false},
            "execution_source_preserved": {"const": true}
          }
        },
        "source_regression": {
          "allOf": [
            {"$ref": "#/$defs/evidenceRef"},
            {
              "type": "object",
              "properties": {"passed_test_count": {"const": 3}},
              "required": ["passed_test_count"]
            }
          ]
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_container_network",
        "provider_control_plane_transport",
        "provider_credential_mounted_in_workflow_container",
        "eda_container_network",
        "private_evaluator_mounted",
        "raw_provider_payload_in_public_receipts"
      ],
      "properties": {
        "workflow_container_network": {"const": "none"},
        "provider_control_plane_transport": {"const": "loopback_tcp_to_mounted_unix_socket"},
        "provider_credential_mounted_in_workflow_container": {"const": false},
        "eda_container_network": {"const": "none"},
        "private_evaluator_mounted": {"const": false},
        "raw_provider_payload_in_public_receipts": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_preflight_passed",
        "networkless_transport_smoke_passed",
        "actual_airtl_workflow_observed",
        "provider_eda_isolation_observed",
        "cross_host_reproduced",
        "launcher_self_binding_exercised",
        "common_model_frozen",
        "runtime_release_frozen",
        "adapter_integration_complete",
        "independent_review_complete",
        "adapter_ready",
        "publication_permitted"
      ],
      "properties": {
        "provider_preflight_passed": {"const": true},
        "networkless_transport_smoke_passed": {"const": true},
        "actual_airtl_workflow_observed": {"const": true},
        "provider_eda_isolation_observed": {"const": true},
        "cross_host_reproduced": {"const": false},
        "launcher_self_binding_exercised": {"const": false},
        "common_model_frozen": {"const": false},
        "runtime_release_frozen": {"const": false},
        "adapter_integration_complete": {"const": false},
        "independent_review_complete": {"const": false},
        "adapter_ready": {"const": false},
        "publication_permitted": {"const": false}
      }
    },
    "remaining_blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"type": "string", "pattern": "^SERVER26:rtlflowbench/evidence/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
