{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/workflow-activity-ledger.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observed_at", "measurement_id", "measurement_scope",
    "workflow_slot_id", "workflow_id", "task_id", "attempt_id",
    "source_binding", "runtime_binding", "process_measurement_receipt_sha256", "timing", "controllers", "provider_budget",
    "completeness", "activities", "attempt_accounting", "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.workflow_activity_ledger.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "measurement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "measurement_scope": {"const": "full_workflow_calibration"},
    "workflow_slot_id": {"enum": ["chipflow", "same_model_vanilla_agent", "external_airtl_1", "external_airtl_2", "external_airtl_3"]},
    "workflow_id": {"enum": ["chipflow", "same_model_vanilla_agent", "mage", "verilogcoder", "hdlagent"]},
    "task_id": {"type": "string", "pattern": "^G(?:0[1-9]|1[0-2])-[a-z0-9-]+$"},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "runtime_binding": {"$ref": "#/$defs/runtimeBinding"},
    "process_measurement_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["clock", "origin", "interval_semantics"],
      "properties": {
        "clock": {"const": "monotonic_ns"},
        "origin": {"const": "measurement_envelope_process_start"},
        "interval_semantics": {"const": "half_open_started_inclusive_completed_exclusive"}
      }
    },
    "controllers": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_gateway", "eda_broker"],
      "properties": {
        "provider_gateway": {"$ref": "#/$defs/controllerBinding"},
        "eda_broker": {"$ref": "#/$defs/controllerBinding"}
      }
    },
    "provider_budget": {"$ref": "#/$defs/providerBudget"},
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "provider_gateway_observation_complete", "eda_broker_observation_complete",
        "all_provider_calls_routed_through_observer", "all_eda_invocations_routed_through_observer",
        "raw_provider_response_exposed", "credentials_exposed",
        "private_evaluator_instrumented", "task_workspace_can_write_ledger"
      ],
      "properties": {
        "provider_gateway_observation_complete": {"const": true},
        "eda_broker_observation_complete": {"const": true},
        "all_provider_calls_routed_through_observer": {"const": true},
        "all_eda_invocations_routed_through_observer": {"const": true},
        "raw_provider_response_exposed": {"const": false},
        "credentials_exposed": {"const": false},
        "private_evaluator_instrumented": {"const": false},
        "task_workspace_can_write_ledger": {"const": false}
      }
    },
    "activities": {
      "type": "array", "maxItems": 100000,
      "items": {"$ref": "#/$defs/activity"}
    },
    "attempt_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["official_attempt_started", "official_semantic_attempt_consumed", "resource_calibration_attempt_consumed", "benchmark_result_created", "private_evaluator_calls"],
      "properties": {
        "official_attempt_started": {"const": false},
        "official_semantic_attempt_consumed": {"const": false},
        "resource_calibration_attempt_consumed": {"const": true},
        "benchmark_result_created": {"const": false},
        "private_evaluator_calls": {"const": 0}
      }
    },
    "excluded_claims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 40}}
  },
  "allOf": [
    {"if": {"properties": {"workflow_slot_id": {"const": "chipflow"}}}, "then": {"properties": {"workflow_id": {"const": "chipflow"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "same_model_vanilla_agent"}}}, "then": {"properties": {"workflow_id": {"const": "same_model_vanilla_agent"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_1"}}}, "then": {"properties": {"workflow_id": {"const": "mage"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_2"}}}, "then": {"properties": {"workflow_id": {"const": "verilogcoder"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_3"}}}, "then": {"properties": {"workflow_id": {"const": "hdlagent"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["image_digest", "image_id"],
      "properties": {
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "controllerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["controller_id", "version", "config_sha256", "source_sha256"],
      "properties": {
        "controller_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "providerBudget": {
      "type": "object", "additionalProperties": false,
      "required": [
        "maximum_forwarded_calls", "maximum_output_tokens_per_call",
        "maximum_input_tokens", "maximum_output_tokens",
        "maximum_consecutive_identical_requests",
        "maximum_consecutive_identical_errors", "forwarded_call_count",
        "rejected_call_count", "rejection_counts",
        "highest_consecutive_identical_request_count",
        "highest_consecutive_identical_error_count", "exhausted", "token_usage"
      ],
      "properties": {
        "maximum_forwarded_calls": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximum_output_tokens_per_call": {"type": "integer", "minimum": 1},
        "maximum_input_tokens": {"type": "integer", "minimum": 1},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "maximum_consecutive_identical_requests": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_consecutive_identical_errors": {"type": "integer", "minimum": 1, "maximum": 64},
        "forwarded_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "output_token_bound_clamp_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "rejected_call_count": {"type": "integer", "minimum": 0},
        "rejection_counts": {
          "type": "object", "additionalProperties": false,
          "required": [
            "call_limit", "input_token_limit", "output_token_limit",
            "token_accounting_incomplete", "repeated_request", "repeated_error"
          ],
          "properties": {
            "call_limit": {"type": "integer", "minimum": 0},
            "input_token_limit": {"type": "integer", "minimum": 0},
            "output_token_limit": {"type": "integer", "minimum": 0},
            "token_accounting_incomplete": {"type": "integer", "minimum": 0},
            "repeated_request": {"type": "integer", "minimum": 0},
            "repeated_error": {"type": "integer", "minimum": 0}
          }
        },
        "highest_consecutive_identical_request_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "highest_consecutive_identical_error_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "exhausted": {"type": "boolean"},
        "token_usage": {"$ref": "#/$defs/tokenUsage"}
      }
    },
    "tokenUsage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "accounting_policy", "measurement_complete", "expected_call_count",
        "observed_call_count", "unobserved_call_count", "input_tokens",
        "output_tokens", "total_tokens", "cache_measurement_complete",
        "cache_observed_call_count", "cache_unobserved_call_count",
        "cache_hit_input_tokens", "cache_miss_input_tokens",
        "raw_content_embedded"
      ],
      "properties": {
        "accounting_policy": {"const": "controller_observed_openai_compatible_usage_v2"},
        "measurement_complete": {"type": "boolean"},
        "expected_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_input_tokens": {"type": "integer", "minimum": 0},
        "observed_output_tokens": {"type": "integer", "minimum": 0},
        "observed_total_tokens": {"type": "integer", "minimum": 0},
        "cache_measurement_complete": {"type": "boolean"},
        "cache_observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "cache_unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "cache_hit_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_miss_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_cache_hit_input_tokens": {"type": "integer", "minimum": 0},
        "observed_cache_miss_input_tokens": {"type": "integer", "minimum": 0},
        "finish_reason_measurement_complete": {"type": "boolean"},
        "finish_reason_observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "finish_reason_unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "finish_reason_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["stop", "length", "tool_calls", "content_filter", "function_call", "unknown"],
          "properties": {
            "stop": {"type": "integer", "minimum": 0},
            "length": {"type": "integer", "minimum": 0},
            "tool_calls": {"type": "integer", "minimum": 0},
            "content_filter": {"type": "integer", "minimum": 0},
            "function_call": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        },
        "output_cap_reached_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "output_cap_with_length_finish_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "raw_content_embedded": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"measurement_complete": {"const": true}}, "required": ["measurement_complete"]},
          "then": {"properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "total_tokens": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"measurement_complete": {"const": false}}, "required": ["measurement_complete"]},
          "then": {"properties": {"input_tokens": {"type": "null"}, "output_tokens": {"type": "null"}, "total_tokens": {"type": "null"}}}
        },
        {
          "if": {"properties": {"cache_measurement_complete": {"const": true}}, "required": ["cache_measurement_complete"]},
          "then": {"properties": {"cache_hit_input_tokens": {"type": "integer"}, "cache_miss_input_tokens": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"cache_measurement_complete": {"const": false}}, "required": ["cache_measurement_complete"]},
          "then": {"properties": {"cache_hit_input_tokens": {"type": "null"}, "cache_miss_input_tokens": {"type": "null"}}}
        }
      ]
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "kind", "controller", "started_offset_ns", "completed_offset_ns", "outcome", "event_binding_sha256", "raw_content_embedded"],
      "properties": {
        "activity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"},
        "kind": {"enum": ["llm_call", "eda_compile_or_lint", "eda_simulation", "eda_formal", "eda_synthesis"]},
        "controller": {"enum": ["provider_gateway", "eda_broker"]},
        "started_offset_ns": {"type": "integer", "minimum": 0},
        "completed_offset_ns": {"type": "integer", "minimum": 1},
        "outcome": {"enum": ["completed", "failed", "timed_out"]},
        "event_binding_sha256": {"$ref": "#/$defs/sha256"},
        "raw_content_embedded": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "llm_call"}}}, "then": {"properties": {"controller": {"const": "provider_gateway"}}}, "else": {"properties": {"controller": {"const": "eda_broker"}}}}
      ]
    }
  }
}
