{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/full-workflow-resource-measurement-receipt.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "observed_at", "status", "measurement_id", "workflow_slot_id", "workflow_id", "task_id", "attempt_id", "source_binding", "runtime_binding", "input_sha256", "metrics", "launcher", "completeness", "attempt_accounting", "readiness", "excluded_claims"],
  "properties": {
    "schema_version": {"const": "rtlflowbench.full_workflow_resource_measurement_receipt.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["full_workflow_resource_sample_complete", "full_workflow_resource_sample_ineligible"]},
    "measurement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "workflow_slot_id": {"enum": ["chipflow", "same_model_vanilla_agent", "external_airtl_1", "external_airtl_2", "external_airtl_3"]},
    "workflow_id": {"enum": ["chipflow", "same_model_vanilla_agent", "mage", "verilogcoder", "hdlagent"]},
    "task_id": {"type": "string", "pattern": "^G(?:0[1-9]|1[0-2])-[a-z0-9-]+$"},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "runtime_binding": {"$ref": "#/$defs/runtimeBinding"},
    "input_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["process_measurement_receipt", "activity_concurrency_receipt", "merger", "process_receipt_schema", "activity_receipt_schema", "merged_receipt_schema"],
      "properties": {
        "process_measurement_receipt": {"$ref": "#/$defs/sha256"},
        "activity_concurrency_receipt": {"$ref": "#/$defs/sha256"},
        "merger": {"$ref": "#/$defs/sha256"},
        "process_receipt_schema": {"$ref": "#/$defs/sha256"},
        "activity_receipt_schema": {"$ref": "#/$defs/sha256"},
        "merged_receipt_schema": {"$ref": "#/$defs/sha256"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["peak_memory_bytes", "cpu_time_seconds", "wall_time_seconds", "peak_scratch_bytes", "peak_process_count", "peak_eda_concurrency", "peak_llm_concurrency", "peak_eda_concurrency_by_kind", "activity_count", "provider_call_limit", "provider_call_count", "provider_budget_rejection_count", "provider_budget_exhausted", "token_usage", "sample_count", "sampling_interval_ms"],
      "properties": {
        "peak_memory_bytes": {"type": "integer", "minimum": 1},
        "cpu_time_seconds": {"type": "number", "minimum": 0},
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_scratch_bytes": {"type": "integer", "minimum": 0},
        "peak_process_count": {"type": "integer", "minimum": 1},
        "peak_eda_concurrency": {"type": "integer", "minimum": 0},
        "peak_llm_concurrency": {"type": "integer", "minimum": 0},
        "peak_eda_concurrency_by_kind": {"type": "object", "additionalProperties": false, "required": ["compile_or_lint", "simulation", "formal", "synthesis"], "properties": {"compile_or_lint": {"type": "integer", "minimum": 0}, "simulation": {"type": "integer", "minimum": 0}, "formal": {"type": "integer", "minimum": 0}, "synthesis": {"type": "integer", "minimum": 0}}},
        "forced_eda_activity_closure_count": {"type": "integer", "minimum": 0},
        "activity_count": {"type": "integer", "minimum": 0},
        "provider_call_limit": {"type": "integer", "minimum": 1, "maximum": 4096},
        "provider_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "provider_budget_rejection_count": {"type": "integer", "minimum": 0},
        "provider_budget_exhausted": {"type": "boolean"},
        "token_usage": {"$ref": "#/$defs/tokenUsage"},
        "sample_count": {"type": "integer", "minimum": 1},
        "sampling_interval_ms": {"type": "integer", "minimum": 10}
      }
    },
    "launcher": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "exit_code", "timed_out"],
      "properties": {
        "outcome": {"enum": ["exited_zero", "exited_nonzero", "timed_out"]},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "controller_guard_terminated": {"type": "boolean"},
        "controller_guard_reason": {"type": ["string", "null"], "enum": [null, "call_limit", "input_token_limit", "output_token_limit", "token_accounting_incomplete", "repeated_request", "repeated_error"]}
      }
    },
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["process_tree_measurement_complete", "container_cgroup_measurement_complete", "scratch_integrity_valid", "activity_timeline_complete", "provider_gateway_observation_complete", "eda_broker_observation_complete", "all_provider_calls_routed_through_observer", "all_eda_invocations_routed_through_observer", "activity_within_measured_wall_time"],
      "properties": {
        "process_tree_measurement_complete": {"type": "boolean"},
        "container_cgroup_measurement_complete": {"type": "boolean"},
        "scratch_integrity_valid": {"type": "boolean"},
        "activity_timeline_complete": {"const": true},
        "provider_gateway_observation_complete": {"const": true},
        "eda_broker_observation_complete": {"const": true},
        "all_provider_calls_routed_through_observer": {"const": true},
        "all_eda_invocations_routed_through_observer": {"const": true},
        "activity_within_measured_wall_time": {"type": "boolean"}
      }
    },
    "attempt_accounting": {"$ref": "#/$defs/accounting"},
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_complete", "sample_eligible_for_resource_cohort", "workflow_calibration_complete", "host_capacity_policy_derivation_permitted", "official_attempts_permitted"],
      "properties": {
        "sample_complete": {"type": "boolean"},
        "sample_eligible_for_resource_cohort": {"type": "boolean"},
        "workflow_calibration_complete": {"const": false},
        "host_capacity_policy_derivation_permitted": {"const": false},
        "official_attempts_permitted": {"const": false}
      }
    },
    "excluded_claims": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 40}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "full_workflow_resource_sample_complete"}}}, "then": {"properties": {"readiness": {"properties": {"sample_complete": {"const": true}, "sample_eligible_for_resource_cohort": {"const": true}}}}}},
    {"if": {"properties": {"status": {"const": "full_workflow_resource_sample_ineligible"}}}, "then": {"properties": {"readiness": {"properties": {"sample_eligible_for_resource_cohort": {"const": false}}}}}},
    {
      "if": {
        "properties": {
          "launcher": {
            "properties": {"controller_guard_terminated": {"const": true}},
            "required": ["controller_guard_terminated"]
          }
        }
      },
      "then": {
        "properties": {
          "launcher": {
            "properties": {
              "controller_guard_reason": {"type": "string"},
              "timed_out": {"const": false},
              "outcome": {"enum": ["exited_zero", "exited_nonzero"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "launcher": {
            "properties": {"controller_guard_terminated": {"const": false}},
            "required": ["controller_guard_terminated"]
          }
        }
      },
      "then": {
        "properties": {
          "launcher": {
            "properties": {"controller_guard_reason": {"type": "null"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["commit", "manifest_sha256"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "runtimeBinding": {"type": "object", "additionalProperties": false, "required": ["image_digest", "image_id"], "properties": {"image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "tokenUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["accounting_policy", "measurement_complete", "expected_call_count", "observed_call_count", "unobserved_call_count", "input_tokens", "output_tokens", "total_tokens", "cache_measurement_complete", "cache_observed_call_count", "cache_unobserved_call_count", "cache_hit_input_tokens", "cache_miss_input_tokens", "raw_content_embedded"],
      "properties": {
        "accounting_policy": {"const": "controller_observed_openai_compatible_usage_v2"},
        "measurement_complete": {"type": "boolean"},
        "expected_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_input_tokens": {"type": "integer", "minimum": 0},
        "observed_output_tokens": {"type": "integer", "minimum": 0},
        "observed_total_tokens": {"type": "integer", "minimum": 0},
        "cache_measurement_complete": {"type": "boolean"},
        "cache_observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "cache_unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "cache_hit_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_miss_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_cache_hit_input_tokens": {"type": "integer", "minimum": 0},
        "observed_cache_miss_input_tokens": {"type": "integer", "minimum": 0},
        "finish_reason_measurement_complete": {"type": "boolean"},
        "finish_reason_observed_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "finish_reason_unobserved_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "finish_reason_counts": {"type": "object", "additionalProperties": false, "required": ["stop", "length", "tool_calls", "content_filter", "function_call", "unknown"], "properties": {"stop": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "content_filter": {"type": "integer", "minimum": 0}, "function_call": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}}},
        "output_cap_reached_call_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "output_cap_with_length_finish_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "raw_content_embedded": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"measurement_complete": {"const": true}}, "required": ["measurement_complete"]}, "then": {"properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "total_tokens": {"type": "integer"}}}},
        {"if": {"properties": {"measurement_complete": {"const": false}}, "required": ["measurement_complete"]}, "then": {"properties": {"input_tokens": {"type": "null"}, "output_tokens": {"type": "null"}, "total_tokens": {"type": "null"}}}},
        {"if": {"properties": {"cache_measurement_complete": {"const": true}}, "required": ["cache_measurement_complete"]}, "then": {"properties": {"cache_hit_input_tokens": {"type": "integer"}, "cache_miss_input_tokens": {"type": "integer"}}}},
        {"if": {"properties": {"cache_measurement_complete": {"const": false}}, "required": ["cache_measurement_complete"]}, "then": {"properties": {"cache_hit_input_tokens": {"type": "null"}, "cache_miss_input_tokens": {"type": "null"}}}}
      ]
    },
    "accounting": {"type": "object", "additionalProperties": false, "required": ["official_attempt_started", "official_semantic_attempt_consumed", "resource_calibration_attempt_consumed", "benchmark_result_created", "private_evaluator_calls"], "properties": {"official_attempt_started": {"const": false}, "official_semantic_attempt_consumed": {"const": false}, "resource_calibration_attempt_consumed": {"const": true}, "benchmark_result_created": {"const": false}, "private_evaluator_calls": {"const": 0}}}
  }
}
