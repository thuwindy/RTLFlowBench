{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/chipflow-resource-block-projection.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "observed_at",
    "status",
    "scope",
    "input_sha256",
    "historical_execution_binding",
    "post_run_source_changes",
    "sample_count",
    "task_count",
    "samples",
    "summary",
    "attempt_accounting",
    "readiness",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.chipflow_resource_block_projection.v1"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "projection_complete_not_benchmark_verdict"},
    "scope": {
      "const": "chipflow_40_resource_calibration_checkpoint_blocks_only"
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_set",
        "measurement_set_schema",
        "resource_receipt_schema",
        "runtime_source_descriptor",
        "execution_controller",
        "current_controller",
        "projection_builder",
        "projection_schema"
      ],
      "properties": {
        "measurement_set": {"$ref": "#/$defs/sha256"},
        "measurement_set_schema": {"$ref": "#/$defs/sha256"},
        "resource_receipt_schema": {"$ref": "#/$defs/sha256"},
        "runtime_source_descriptor": {"$ref": "#/$defs/sha256"},
        "execution_controller": {"$ref": "#/$defs/sha256"},
        "current_controller": {"$ref": "#/$defs/sha256"},
        "projection_builder": {"$ref": "#/$defs/sha256"},
        "projection_schema": {"$ref": "#/$defs/sha256"}
      }
    },
    "historical_execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "runtime_component_manifest_sha256",
        "runtime_image_digest",
        "runtime_image_id",
        "execution_controller_source_sha256"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runtime_component_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_image_digest": {"$ref": "#/$defs/imageDigest"},
        "runtime_image_id": {"$ref": "#/$defs/imageDigest"},
        "execution_controller_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "post_run_source_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "execution_sha256",
          "current_sha256",
          "classification",
          "affects_execution_semantics",
          "affects_result_projection"
        ],
        "properties": {
          "path": {"const": "benchmarks/golden12/chipflow/controller.py"},
          "execution_sha256": {"$ref": "#/$defs/sha256"},
          "current_sha256": {"$ref": "#/$defs/sha256"},
          "classification": {
            "const": "public_block_evidence_projection_only_no_execution_semantics_change"
          },
          "affects_execution_semantics": {"const": false},
          "affects_result_projection": {"const": true}
        }
      }
    },
    "sample_count": {"const": 40},
    "task_count": {"const": 12},
    "samples": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sample"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_block_sample_count",
        "task_sample_counts",
        "category_counts",
        "raw_block_reason_count",
        "benchmark_verdict_count"
      ],
      "properties": {
        "projected_block_sample_count": {"const": 40},
        "task_sample_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "G01-common-fifo-spec",
            "G02-common-rr-arbiter-spec",
            "G03-axis-fifo-backpressure",
            "G04-wb2axip-split-bridge",
            "G05-picorv32-missing-irq",
            "G06-ibex-debug-csr-exception",
            "G07-ibex-ifetch-error-timing",
            "G08-common-fifo-dv",
            "G09-axis-fifo-dv",
            "G10-serv-area-qor",
            "G11-picorv32-qor",
            "G12-common-cdc-missing-contract"
          ],
          "properties": {
            "G01-common-fifo-spec": {"const": 3},
            "G02-common-rr-arbiter-spec": {"const": 3},
            "G03-axis-fifo-backpressure": {"const": 3},
            "G04-wb2axip-split-bridge": {"const": 3},
            "G05-picorv32-missing-irq": {"const": 3},
            "G06-ibex-debug-csr-exception": {"const": 3},
            "G07-ibex-ifetch-error-timing": {"const": 3},
            "G08-common-fifo-dv": {"const": 3},
            "G09-axis-fifo-dv": {"const": 3},
            "G10-serv-area-qor": {"const": 5},
            "G11-picorv32-qor": {"const": 5},
            "G12-common-cdc-missing-contract": {"const": 3}
          }
        },
        "category_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^(native_design_contract_validation_failed|capability_execution_preflight_failed|structured_implementation_anchor_contract_failed|structured_schema_validation_failed|safe_executor_unavailable|judge_did_not_accept|eda_debug_budget_exhausted|missing_native_block_reason|unclassified_native_block)$": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          }
        },
        "raw_block_reason_count": {"const": 0},
        "benchmark_verdict_count": {"const": 0}
      }
    },
    "attempt_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_resource_calibration_samples_projected",
        "projection_provider_calls",
        "projection_eda_calls",
        "projection_private_evaluator_calls",
        "official_attempts_started",
        "official_semantic_attempts_consumed",
        "benchmark_results_created"
      ],
      "properties": {
        "historical_resource_calibration_samples_projected": {"const": 40},
        "projection_provider_calls": {"const": 0},
        "projection_eda_calls": {"const": 0},
        "projection_private_evaluator_calls": {"const": 0},
        "official_attempts_started": {"const": 0},
        "official_semantic_attempts_consumed": {"const": 0},
        "benchmark_results_created": {"const": 0}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_projection_complete",
        "resource_workflow_calibration_complete",
        "independent_review_complete",
        "official_attempts_permitted",
        "benchmark_verdict_produced"
      ],
      "properties": {
        "diagnostic_projection_complete": {"const": true},
        "resource_workflow_calibration_complete": {"const": false},
        "independent_review_complete": {"const": false},
        "official_attempts_permitted": {"const": false},
        "benchmark_verdict_produced": {"const": false}
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 50}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "enum": [
        "G01-common-fifo-spec",
        "G02-common-rr-arbiter-spec",
        "G03-axis-fifo-backpressure",
        "G04-wb2axip-split-bridge",
        "G05-picorv32-missing-irq",
        "G06-ibex-debug-csr-exception",
        "G07-ibex-ifetch-error-timing",
        "G08-common-fifo-dv",
        "G09-axis-fifo-dv",
        "G10-serv-area-qor",
        "G11-picorv32-qor",
        "G12-common-cdc-missing-contract"
      ]
    },
    "category": {
      "enum": [
        "native_design_contract_validation_failed",
        "capability_execution_preflight_failed",
        "structured_implementation_anchor_contract_failed",
        "structured_schema_validation_failed",
        "safe_executor_unavailable",
        "judge_did_not_accept",
        "eda_debug_budget_exhausted",
        "missing_native_block_reason",
        "unclassified_native_block"
      ]
    },
    "blockEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "categories",
        "reason_sha256",
        "reason_size_bytes",
        "raw_reason_included"
      ],
      "properties": {
        "schema_version": {
          "const": "rtlflowbench.chipflow_public_block_evidence.v1"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/category"}
        },
        "reason_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "reason_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_reason_included": {"const": false}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "task_id",
        "calibration_run_index",
        "resource_receipt_sha256",
        "control_receipt_sha256",
        "checkpoint_sha256",
        "binding_assertion_sha256",
        "checkpoint_read_mode",
        "checkpoint_summary",
        "native_stage",
        "native_status",
        "artifact_count",
        "block_evidence",
        "submission_observed",
        "private_evaluator_run",
        "benchmark_verdict_produced",
        "official_attempt"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^resource-chipflow-g(?:0[1-9]|1[0-2])-run-[1-5]$"
        },
        "task_id": {"$ref": "#/$defs/taskId"},
        "calibration_run_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "resource_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "control_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "binding_assertion_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_read_mode": {"const": "sqlite_uri_mode_ro_immutable_1"},
        "checkpoint_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["row_count", "thread_count", "namespace_count"],
          "properties": {
            "row_count": {"type": "integer", "minimum": 1},
            "thread_count": {"const": 1},
            "namespace_count": {"const": 1}
          }
        },
        "native_stage": {"const": "BLOCKED"},
        "native_status": {"const": "blocked"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "block_evidence": {"$ref": "#/$defs/blockEvidence"},
        "submission_observed": {"const": false},
        "private_evaluator_run": {"const": false},
        "benchmark_verdict_produced": {"const": false},
        "official_attempt": {"const": false}
      }
    }
  }
}
