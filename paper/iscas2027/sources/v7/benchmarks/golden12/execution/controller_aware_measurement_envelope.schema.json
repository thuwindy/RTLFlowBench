{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/controller-aware-measurement-envelope.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observed_at", "status", "decision", "scope",
    "input_sha256", "isolation", "requests", "summary", "readiness",
    "blockers", "excluded_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "rtlflowbench.controller_aware_measurement_envelope.v1"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "controller_envelope_bound_provider_preflight_pending"},
    "decision": {"const": "BLOCK"},
    "scope": {
      "const": "five_workflows_all_twelve_tasks_resource_measurement_control_only"
    },
    "input_sha256": {
      "type": "object", "additionalProperties": false,
      "required": [
        "resource_request_set", "bridge_request_set", "runner",
        "nonlaunch_receipt_schema", "process_receipt_schema",
        "activity_ledger_schema", "activity_concurrency_builder",
        "resource_merger", "builder", "schema"
      ],
      "properties": {
        "resource_request_set": {"$ref": "#/$defs/sha256"},
        "bridge_request_set": {"$ref": "#/$defs/sha256"},
        "runner": {"$ref": "#/$defs/sha256"},
        "nonlaunch_receipt_schema": {"$ref": "#/$defs/sha256"},
        "process_receipt_schema": {"$ref": "#/$defs/sha256"},
        "activity_ledger_schema": {"$ref": "#/$defs/sha256"},
        "activity_concurrency_builder": {"$ref": "#/$defs/sha256"},
        "resource_merger": {"$ref": "#/$defs/sha256"},
        "builder": {"$ref": "#/$defs/sha256"},
        "schema": {"$ref": "#/$defs/sha256"}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "container_network", "provider_credential_location",
        "raw_provider_content_persisted", "public_bridge_mount",
        "workflow_scratch_mount", "controller_socket_mount",
        "private_evaluator_reachable", "task_solution_knowledge_included"
      ],
      "properties": {
        "container_network": {"const": "none"},
        "provider_credential_location": {"const": "host_controller_only"},
        "raw_provider_content_persisted": {"const": false},
        "public_bridge_mount": {"const": "read_only"},
        "workflow_scratch_mount": {"const": "read_write"},
        "controller_socket_mount": {"const": "read_only"},
        "private_evaluator_reachable": {"const": false},
        "task_solution_knowledge_included": {"const": false}
      }
    },
    "requests": {
      "type": "array", "minItems": 200, "maxItems": 200,
      "items": {"$ref": "#/$defs/request"}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workflow_count", "task_count", "planned_slot_count",
        "launch_plan_bound_count", "nonlaunch_disposition_bound_count",
        "resource_sample_count", "resource_attempt_count",
        "provider_call_count", "eda_call_count",
        "private_evaluator_call_count", "official_attempt_count"
      ],
      "properties": {
        "workflow_count": {"const": 5},
        "task_count": {"const": 12},
        "planned_slot_count": {"const": 200},
        "launch_plan_bound_count": {"const": 98},
        "nonlaunch_disposition_bound_count": {"const": 102},
        "resource_sample_count": {"const": 0},
        "resource_attempt_count": {"const": 0},
        "provider_call_count": {"const": 0},
        "eda_call_count": {"const": 0},
        "private_evaluator_call_count": {"const": 0},
        "official_attempt_count": {"const": 0}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "all_200_controller_dispositions_bound", "controller_envelope_bound",
        "nonlaunch_metrics_are_null", "common_provider_preflight_passed",
        "resource_campaign_permitted",
        "host_capacity_policy_derivation_permitted", "official_attempts_permitted"
      ],
      "properties": {
        "all_200_controller_dispositions_bound": {"const": true},
        "controller_envelope_bound": {"const": true},
        "nonlaunch_metrics_are_null": {"const": true},
        "common_provider_preflight_passed": {"const": false},
        "resource_campaign_permitted": {"const": false},
        "host_capacity_policy_derivation_permitted": {"const": false},
        "official_attempts_permitted": {"const": false}
      }
    },
    "blockers": {"const": ["common_provider_preflight_not_passed"]},
    "excluded_claims": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"type": "string", "minLength": 40}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nullableMetrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "wall_time_seconds", "cpu_time_seconds", "peak_memory_bytes",
        "peak_scratch_bytes", "peak_process_count", "peak_eda_concurrency",
        "peak_llm_concurrency", "llm_call_count", "eda_call_count"
      ],
      "properties": {
        "wall_time_seconds": {"type": "null"},
        "cpu_time_seconds": {"type": "null"},
        "peak_memory_bytes": {"type": "null"},
        "peak_scratch_bytes": {"type": "null"},
        "peak_process_count": {"type": "null"},
        "peak_eda_concurrency": {"type": "null"},
        "peak_llm_concurrency": {"type": "null"},
        "llm_call_count": {"type": "null"},
        "eda_call_count": {"type": "null"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": [
        "measurement_id", "workflow_slot_id", "workflow_id", "task_id",
        "calibration_run_index", "resource_request_sha256",
        "bridge_request_payload_sha256", "controller_disposition",
        "launch_plan_sha256", "nonlaunch_receipt_sha256",
        "resource_metric_availability", "metrics", "provider_calls",
        "eda_calls", "private_evaluator_calls",
        "resource_calibration_attempt_consumed",
        "official_semantic_attempt_consumed"
      ],
      "properties": {
        "measurement_id": {
          "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
        },
        "workflow_slot_id": {
          "enum": [
            "chipflow", "same_model_vanilla_agent", "external_airtl_1",
            "external_airtl_2", "external_airtl_3"
          ]
        },
        "workflow_id": {
          "enum": [
            "chipflow", "same_model_vanilla_agent", "mage",
            "verilogcoder", "hdlagent"
          ]
        },
        "task_id": {
          "type": "string", "pattern": "^G(?:0[1-9]|1[0-2])-[a-z0-9-]+$"
        },
        "calibration_run_index": {"type": "integer", "minimum": 1, "maximum": 5},
        "resource_request_sha256": {"$ref": "#/$defs/sha256"},
        "bridge_request_payload_sha256": {"$ref": "#/$defs/nullableSha256"},
        "controller_disposition": {
          "enum": [
            "launch_request_materialized_not_run",
            "controller_block_preclassified_not_run"
          ]
        },
        "launch_plan_sha256": {"$ref": "#/$defs/nullableSha256"},
        "nonlaunch_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "resource_metric_availability": {
          "enum": [
            "pending_observed_launch_measurement", "not_available_not_launched"
          ]
        },
        "metrics": {"$ref": "#/$defs/nullableMetrics"},
        "provider_calls": {"const": 0},
        "eda_calls": {"const": 0},
        "private_evaluator_calls": {"const": 0},
        "resource_calibration_attempt_consumed": {"const": false},
        "official_semantic_attempt_consumed": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "controller_disposition": {
                "const": "launch_request_materialized_not_run"
              }
            }
          },
          "then": {
            "properties": {
              "launch_plan_sha256": {"$ref": "#/$defs/sha256"},
              "nonlaunch_receipt_sha256": {"type": "null"},
              "resource_metric_availability": {
                "const": "pending_observed_launch_measurement"
              }
            }
          },
          "else": {
            "properties": {
              "bridge_request_payload_sha256": {"type": "null"},
              "launch_plan_sha256": {"type": "null"},
              "nonlaunch_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "resource_metric_availability": {
                "const": "not_available_not_launched"
              }
            }
          }
        }
      ]
    }
  }
}
