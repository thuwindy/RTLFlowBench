{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/controller/workflow-runtime-supersession-set.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observed_at", "status", "scope", "input_sha256",
    "source_sha256", "replacements", "summary", "attempt_accounting",
    "readiness", "blockers", "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.workflow_runtime_supersession_set.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "task_neutral_runtime_supersession_set_validated"},
    "scope": {"const": "runtime_control_repairs_without_task_or_provider_execution"},
    "input_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_runtime_set", "candidate"],
      "properties": {
        "prior_runtime_set": {"$ref": "#/$defs/sha256"},
        "candidate": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["builder", "schema", "podman"],
      "properties": {
        "builder": {"$ref": "#/$defs/sha256"},
        "schema": {"$ref": "#/$defs/sha256"},
        "podman": {"$ref": "#/$defs/sha256"}
      }
    },
    "replacements": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {"$ref": "#/$defs/replacement"}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "replacement_count", "container_probe_count", "task_packet_load_count",
        "provider_call_count", "eda_call_count", "private_evaluator_call_count",
        "benchmark_verdict_count"
      ],
      "properties": {
        "replacement_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "container_probe_count": {"type": "integer", "minimum": 3, "maximum": 6},
        "task_packet_load_count": {"const": 0},
        "provider_call_count": {"const": 0},
        "eda_call_count": {"const": 0},
        "private_evaluator_call_count": {"const": 0},
        "benchmark_verdict_count": {"const": 0}
      }
    },
    "attempt_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["official_attempts_started", "semantic_attempts_consumed", "benchmark_results_created"],
      "properties": {
        "official_attempts_started": {"const": 0},
        "semantic_attempts_consumed": {"const": 0},
        "benchmark_results_created": {"const": 0}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_supersession_validated", "runtime_release_frozen", "official_attempts_permitted"],
      "properties": {
        "runtime_supersession_validated": {"const": true},
        "runtime_release_frozen": {"const": false},
        "official_attempts_permitted": {"const": false}
      }
    },
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_claims": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replacement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workflow_slot_id", "workflow_id", "prior_image_digest", "prior_image_id",
        "replacement_image_digest", "replacement_image_id", "supersession_reason_code",
        "source_commit", "source_manifest_sha256", "stored_image_size_bytes",
        "runtime_control_sha256", "source_descriptor_sha256", "network_policy",
        "task_neutral_help_probe_passed", "runtime_control_source_binding_passed",
        "validation_status"
      ],
      "properties": {
        "workflow_slot_id": {"enum": ["external_airtl_1", "external_airtl_3"]},
        "workflow_id": {"enum": ["mage", "hdlagent"]},
        "prior_image_digest": {"$ref": "#/$defs/image"},
        "prior_image_id": {"$ref": "#/$defs/image"},
        "replacement_image_digest": {"$ref": "#/$defs/image"},
        "replacement_image_id": {"$ref": "#/$defs/image"},
        "supersession_reason_code": {"const": "runtime_control_source_binding_repair"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "stored_image_size_bytes": {"type": "integer", "minimum": 1},
        "runtime_control_sha256": {
          "type": "object", "minProperties": 1, "maxProperties": 2,
          "additionalProperties": {"$ref": "#/$defs/sha256"},
          "required": ["entrypoint"]
        },
        "source_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "network_policy": {"const": "none"},
        "task_neutral_help_probe_passed": {"const": true},
        "runtime_control_source_binding_passed": {"const": true},
        "validation_status": {"const": "task_neutral_runtime_supersession_validated"}
      }
    }
  }
}
