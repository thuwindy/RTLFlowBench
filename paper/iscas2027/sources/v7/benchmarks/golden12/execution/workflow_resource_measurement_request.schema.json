{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/workflow-resource-measurement-request.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "measurement_id", "measurement_scope", "workflow_slot_id", "workflow_id", "task_id", "attempt_id", "argv", "launcher_kind", "launcher_executable_sha256", "runtime_image_argv_index", "working_directory", "timeout_seconds", "sampling_interval_ms", "source_binding", "runtime_binding", "network_policy", "inherited_environment_keys"],
  "properties": {
    "schema_version": {"const": "rtlflowbench.workflow_resource_measurement_request.v1"},
    "measurement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "measurement_scope": {"enum": ["task_free_runtime_baseline", "full_workflow_calibration"]},
    "workflow_slot_id": {"enum": ["chipflow", "same_model_vanilla_agent", "external_airtl_1", "external_airtl_2", "external_airtl_3"]},
    "workflow_id": {"enum": ["chipflow", "same_model_vanilla_agent", "mage", "verilogcoder", "hdlagent"]},
    "task_id": {"type": ["string", "null"], "pattern": "^G(?:0[1-9]|1[0-2])-[a-z0-9-]+$"},
    "attempt_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "launcher_kind": {"const": "podman_oci"},
    "launcher_executable_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_image_argv_index": {"type": "integer", "minimum": 2, "maximum": 126},
    "working_directory": {"type": "string", "pattern": "^(?:[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*)?$"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "sampling_interval_ms": {"type": "integer", "minimum": 10, "maximum": 1000},
    "source_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_sha256"],
      "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "runtime_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["image_digest", "image_id"],
      "properties": {"image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "network_policy": {"const": "offline"},
    "inherited_environment_keys": {"const": ["HOME", "XDG_RUNTIME_DIR"]}
  },
  "allOf": [
    {"if": {"properties": {"measurement_scope": {"const": "task_free_runtime_baseline"}}}, "then": {"properties": {"task_id": {"type": "null"}, "attempt_id": {"type": "null"}}}},
    {"if": {"properties": {"measurement_scope": {"const": "full_workflow_calibration"}}}, "then": {"properties": {"task_id": {"type": "string"}, "attempt_id": {"type": "string"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "chipflow"}}}, "then": {"properties": {"workflow_id": {"const": "chipflow"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "same_model_vanilla_agent"}}}, "then": {"properties": {"workflow_id": {"const": "same_model_vanilla_agent"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_1"}}}, "then": {"properties": {"workflow_id": {"const": "mage"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_2"}}}, "then": {"properties": {"workflow_id": {"const": "verilogcoder"}}}},
    {"if": {"properties": {"workflow_slot_id": {"const": "external_airtl_3"}}}, "then": {"properties": {"workflow_id": {"const": "hdlagent"}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
