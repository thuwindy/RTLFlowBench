{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/guarded-resource-batch-plan.v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "provider", "runner_sha256",
    "author_alpha_content_lock",
    "expected_author_alpha_content_lock_sha256",
    "maximum_slots_per_batch", "provider_policy", "anomaly_thresholds",
    "slots", "attempt_accounting", "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.guarded_resource_batch_plan.v4"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "provider": {"const": "deepseek"},
    "runner_sha256": {"$ref": "#/$defs/sha256"},
    "author_alpha_content_lock": {"$ref": "#/$defs/path"},
    "expected_author_alpha_content_lock_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_slots_per_batch": {"const": 3},
    "provider_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "maximum_calls_per_slot", "maximum_output_tokens_per_call",
        "maximum_input_tokens_per_slot", "maximum_output_tokens_per_slot",
        "maximum_consecutive_identical_requests",
        "maximum_consecutive_identical_errors"
      ],
      "properties": {
        "maximum_calls_per_slot": {"const": 4},
        "maximum_output_tokens_per_call": {"const": 8192},
        "maximum_input_tokens_per_slot": {"const": 163840},
        "maximum_output_tokens_per_slot": {"const": 16384},
        "maximum_consecutive_identical_requests": {"const": 2},
        "maximum_consecutive_identical_errors": {"const": 2}
      }
    },
    "anomaly_thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["warning_input_tokens_per_slot", "warning_output_tokens_per_slot"],
      "properties": {
        "warning_input_tokens_per_slot": {"const": 122880},
        "warning_output_tokens_per_slot": {"const": 12288}
      }
    },
    "slots": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"$ref": "#/$defs/slot"}
    },
    "attempt_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["official_attempts_permitted", "resource_calibration_only"],
      "properties": {
        "official_attempts_permitted": {"const": false},
        "resource_calibration_only": {"const": true}
      }
    },
    "excluded_claims": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "string", "minLength": 40}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slot_id", "resource_request", "bridge_request_set",
        "expected_bridge_request_set_sha256", "common_provider_gate",
        "expected_common_provider_gate_sha256",
        "resource_campaign_authorization",
        "expected_resource_campaign_authorization_sha256", "podman",
        "expected_podman_sha256", "scratch_root", "output_root",
        "mage_eda_image_digest"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^[a-z0-9][A-Za-z0-9._:-]{0,239}$"},
        "resource_request": {"$ref": "#/$defs/path"},
        "bridge_request_set": {"$ref": "#/$defs/path"},
        "expected_bridge_request_set_sha256": {"$ref": "#/$defs/sha256"},
        "common_provider_gate": {"$ref": "#/$defs/path"},
        "expected_common_provider_gate_sha256": {"$ref": "#/$defs/sha256"},
        "resource_campaign_authorization": {"$ref": "#/$defs/path"},
        "expected_resource_campaign_authorization_sha256": {"$ref": "#/$defs/sha256"},
        "podman": {"$ref": "#/$defs/path"},
        "expected_podman_sha256": {"$ref": "#/$defs/sha256"},
        "scratch_root": {"$ref": "#/$defs/path"},
        "output_root": {"$ref": "#/$defs/path"},
        "mage_eda_image_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
