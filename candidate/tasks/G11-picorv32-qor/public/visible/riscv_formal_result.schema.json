{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlflowbench.org/schema/g11-riscv-formal-result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "suite_status",
    "verdict",
    "pass",
    "wall_time_seconds",
    "tool_paths",
    "contract_sha256",
    "scope_receipt",
    "checks",
    "interface_observation",
    "evidence_manifest",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {"const": "rtlflowbench.g11_riscv_formal_result.v1"},
    "task_id": {"const": "G11-picorv32-qor"},
    "suite_status": {"const": "development_structural_projection_not_frozen"},
    "verdict": {
      "enum": ["invalid_submission", "scope_violation", "infra_error", "timeout", "compile_error", "structural_fail", "pass"]
    },
    "pass": {"type": "boolean"},
    "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
    "tool_paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "contract_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "scope_receipt": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "stage", "verdict", "reason"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "stage": {"enum": ["scope", "riscv_formal_elaboration", "riscv_formal_interface"]},
          "verdict": {"enum": ["invalid_submission", "scope_violation", "infra_error", "timeout", "compile_error", "structural_fail", "pass"]},
          "reason": {"type": "string", "minLength": 1},
          "process": {"type": "object"}
        }
      }
    },
    "interface_observation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinary_port_count", "rvfi_port_count", "total_top_port_count", "generic_cell_count_not_area", "netname_count"],
          "properties": {
            "ordinary_port_count": {"const": 27},
            "rvfi_port_count": {"const": 29},
            "total_top_port_count": {"const": 56},
            "generic_cell_count_not_area": {"type": "integer", "minimum": 1},
            "netname_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "evidence_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "excluded_claims": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "error": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {"properties": {"pass": {"const": true}}},
      "else": {"properties": {"pass": {"const": false}}}
    }
  ]
}
