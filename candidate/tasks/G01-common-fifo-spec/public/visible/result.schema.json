{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chipflow.local/schemas/golden12/g01-visible-result-v1.json",
  "title": "G01 development visible result",
  "task_id": "G01-common-fifo-spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "suite_id",
    "suite_status",
    "verdict",
    "pass",
    "wall_time_seconds",
    "tool_paths",
    "scope_receipt",
    "checks",
    "evidence_manifest",
    "excluded_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "chipflow.golden12.visible_result.v1"
    },
    "task_id": {
      "const": "G01-common-fifo-spec"
    },
    "suite_id": {
      "const": "g01-visible-directed-v1-development"
    },
    "suite_status": {
      "const": "development_not_frozen"
    },
    "verdict": {
      "enum": [
        "invalid_submission",
        "scope_violation",
        "infra_error",
        "timeout",
        "compile_error",
        "functional_fail",
        "pass"
      ]
    },
    "pass": {
      "type": "boolean"
    },
    "wall_time_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tool_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "scope_receipt": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "stage",
          "verdict",
          "reason",
          "expected_sentinel"
        ],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "stage": {
            "enum": [
              "scope",
              "compile",
              "simulation",
              "invalid_parameter"
            ]
          },
          "verdict": {
            "enum": [
              "invalid_submission",
              "scope_violation",
              "infra_error",
              "timeout",
              "compile_error",
              "functional_fail",
              "pass"
            ]
          },
          "reason": {"type": "string", "minLength": 1},
          "expected_sentinel": {"type": ["string", "null"]},
          "process": {"type": "object"}
        }
      }
    },
    "evidence_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "excluded_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "runner_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "error": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}}
      },
      "then": {
        "properties": {"pass": {"const": true}}
      },
      "else": {
        "properties": {"pass": {"const": false}}
      }
    }
  ]
}
