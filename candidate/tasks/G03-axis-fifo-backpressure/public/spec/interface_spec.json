{
  "schema_version": "chipflow.golden12.interface_spec.v1",
  "task_id": "G03-axis-fifo-backpressure",
  "interface_kind": "axi_stream_fifo_integration",
  "top_module": "golden12_axis_fifo",
  "language": "systemverilog",
  "cpu_interface_spec_required": false,
  "projection": "independent_non_cpu_interface_spec",
  "parameters": [
    {
      "name": "DATA_WIDTH",
      "type": "positive_integer",
      "default": 32,
      "valid_range": "DATA_WIDTH >= 8 and DATA_WIDTH % 8 == 0"
    },
    {
      "name": "DEPTH_BYTES",
      "type": "positive_integer",
      "default": 1024,
      "valid_range": "DEPTH_BYTES % (DATA_WIDTH/8) == 0 and DEPTH_BYTES/(DATA_WIDTH/8) is a power of two >= 2"
    }
  ],
  "clock": {
    "port": "clk",
    "active_edge": "rising",
    "clock_domains": 1
  },
  "reset": {
    "port": "rst",
    "polarity": "active_high",
    "timing": "synchronous",
    "sample_edge": "rising_clk",
    "priority": "higher_than_stream_handshakes",
    "asynchronous_effect_between_edges": false
  },
  "ports": [
    {"name": "clk", "direction": "input", "width": "1"},
    {"name": "rst", "direction": "input", "width": "1"},
    {"name": "s_axis_tdata", "direction": "input", "width": "DATA_WIDTH"},
    {"name": "s_axis_tkeep", "direction": "input", "width": "DATA_WIDTH/8"},
    {"name": "s_axis_tvalid", "direction": "input", "width": "1"},
    {"name": "s_axis_tready", "direction": "output", "width": "1"},
    {"name": "s_axis_tlast", "direction": "input", "width": "1"},
    {"name": "m_axis_tdata", "direction": "output", "width": "DATA_WIDTH"},
    {"name": "m_axis_tkeep", "direction": "output", "width": "DATA_WIDTH/8"},
    {"name": "m_axis_tvalid", "direction": "output", "width": "1"},
    {"name": "m_axis_tready", "direction": "input", "width": "1"},
    {"name": "m_axis_tlast", "direction": "output", "width": "1"},
    {"name": "status_overflow", "direction": "output", "width": "1"},
    {"name": "status_good_frame", "direction": "output", "width": "1"}
  ],
  "transaction_semantics": {
    "input_accept": "s_axis_tvalid && s_axis_tready at a rising edge",
    "output_accept": "m_axis_tvalid && m_axis_tready at a rising edge",
    "ordering": "Accepted non-dropped frames and their beats are emitted exactly once in acceptance order",
    "frame_boundary": "tlast terminates a frame and output tlast matches the corresponding accepted input frame boundary",
    "stalled_input": "An input beat is not accepted while s_axis_tready is low; the source owns stability until acceptance",
    "stalled_output": "While m_axis_tvalid && !m_axis_tready, valid, data, keep, and last remain stable",
    "oversize_frame": "A frame exceeding DEPTH_BYTES is discarded without an output prefix and pulses status_overflow once at termination"
  },
  "state_semantics": {
    "frame_commit": "status_good_frame pulses for one cycle when a complete non-dropped frame is committed",
    "partial_frame_visibility": "A partial input frame is never visible at the output",
    "reset_state": "m_axis_tvalid=0, status_overflow=0, status_good_frame=0, and no pre-reset or partial frame remains buffered",
    "metadata": "tdata, tkeep, and tlast are preserved for every emitted beat"
  },
  "latency_semantics": {
    "mode": "implementation_pipeline_not_cycle_frozen",
    "fall_through_required": false,
    "progress": "A committed frame eventually becomes transferable when m_axis_tready remains asserted"
  },
  "invalid_parameter_behavior": {
    "required_result": "elaboration_or_static_failure",
    "runtime_behavior_defined": false
  },
  "dependency_bindings": [
    {
      "module": "axis_fifo",
